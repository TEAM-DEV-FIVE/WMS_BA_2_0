# Local development only. Set the user/password through your environment.
# The server never reads this file automatically. Export WMS_DATABASE_URL first.
WMS_DATABASE_URL=postgresql+psycopg://wms_dev@localhost:5432/wms_dev
WMS_HOST=127.0.0.1
WMS_PORT=8000
# Required to enroll/use MFA; generate once and keep outside Git, backed up separately.
# WMS_MFA_ENCRYPTION_KEY=<Fernet key generated by the operator>
WMS_ACCESS_TTL_SECONDS=900
WMS_SESSION_TTL_SECONDS=28800
WMS_BUSINESS_TIMEZONE=Asia/Ho_Chi_Minh

# Desktop accepts plain HTTP only on loopback for development.
WMS_API_URL=http://127.0.0.1:8000/api/v1
# For LAN: https://wms.example.internal/api/v1
# WMS_CA_FILE=/path/to/internal-ca.crt
# Optional desktop local directory; keep device.sqlite3 and receipts/ across upgrades.
# Default: %LOCALAPPDATA%/wms-lan on Windows, $XDG_DATA_HOME/wms-lan or ~/.local/share/wms-lan on Linux.
# Use a local disk, not a network share. No password/access/refresh token is stored here.
# WMS_LOCAL_DATA_DIR=/path/to/local/wms-lan
