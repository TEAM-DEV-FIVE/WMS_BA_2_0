digraph WMS {
graph [rankdir=LR, bgcolor="white", nodesep=.32, ranksep=.6, pad=.28];
node [shape=plain, fontname="DejaVu Sans", fontsize=12];
edge [fontname="DejaVu Sans", fontsize=10, color="#567086", fontcolor="#334155", arrowsize=.7];
label="ERD hiện hành · count_observation"; labelloc=t; fontname="DejaVu Sans"; fontsize=20;
"count_observation" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>count_observation</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id : uuid</TD></TR><TR><TD ALIGN="LEFT">count_line_id : uuid</TD></TR><TR><TD ALIGN="LEFT">round_no : integer</TD></TR><TR><TD ALIGN="LEFT">quantity : numeric(20,6)</TD></TR><TR><TD ALIGN="LEFT">counted_by : uuid</TD></TR><TR><TD ALIGN="LEFT">counted_at : timestamp with time zone</TD></TR><TR><TD ALIGN="LEFT">scan_event_key : uuid ?</TD></TR><TR><TD ALIGN="LEFT">reason : text</TD></TR></TABLE>>];
"count_line" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>count_line</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Bảng đích — các cột được tham chiếu</TD></TR><TR><TD ALIGN="LEFT">id : uuid</TD></TR></TABLE>>];
"app_user" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>app_user</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Bảng đích — các cột được tham chiếu</TD></TR><TR><TD ALIGN="LEFT">id : uuid</TD></TR></TABLE>>];
"count_observation" -> "count_line" [label="count_line_id → id"];
"count_observation" -> "app_user" [label="counted_by → id"];
}