digraph WMS {
graph [rankdir=LR, bgcolor="white", nodesep=.32, ranksep=.6, pad=.28];
node [shape=plain, fontname="DejaVu Sans", fontsize=12];
edge [fontname="DejaVu Sans", fontsize=10, color="#567086", fontcolor="#334155", arrowsize=.7];
label="ERD hiện hành · audit_event"; labelloc=t; fontname="DejaVu Sans"; fontsize=20;
"audit_event" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>audit_event</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id : uuid</TD></TR><TR><TD ALIGN="LEFT">actor_id : uuid ?</TD></TR><TR><TD ALIGN="LEFT">warehouse_id : uuid ?</TD></TR><TR><TD ALIGN="LEFT">action : character varying(100)</TD></TR><TR><TD ALIGN="LEFT">entity_type : character varying(80)</TD></TR><TR><TD ALIGN="LEFT">entity_id : uuid ?</TD></TR><TR><TD ALIGN="LEFT">request_id : uuid</TD></TR><TR><TD ALIGN="LEFT">occurred_at : timestamp with time zone</TD></TR><TR><TD ALIGN="LEFT">before_data : jsonb ?</TD></TR><TR><TD ALIGN="LEFT">after_data : jsonb ?</TD></TR><TR><TD ALIGN="LEFT">reason : text ?</TD></TR></TABLE>>];
"app_user" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>app_user</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Bảng đích — các cột được tham chiếu</TD></TR><TR><TD ALIGN="LEFT">id : uuid</TD></TR></TABLE>>];
"warehouse" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>warehouse</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Bảng đích — các cột được tham chiếu</TD></TR><TR><TD ALIGN="LEFT">id : uuid</TD></TR></TABLE>>];
"audit_event" -> "app_user" [label="actor_id → id"];
"audit_event" -> "warehouse" [label="warehouse_id → id"];
}