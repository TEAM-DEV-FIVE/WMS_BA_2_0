digraph WMS {
graph [rankdir=LR, bgcolor="white", nodesep=.32, ranksep=.6, pad=.28];
node [shape=plain, fontname="DejaVu Sans", fontsize=12];
edge [fontname="DejaVu Sans", fontsize=10, color="#567086", fontcolor="#334155", arrowsize=.7];
label="ERD hiện hành · worker_status"; labelloc=t; fontname="DejaVu Sans"; fontsize=20;
"worker_status" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>worker_status</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id : uuid</TD></TR><TR><TD ALIGN="LEFT">kind : character varying(20)</TD></TR><TR><TD ALIGN="LEFT">registry_hash : character(64)</TD></TR><TR><TD ALIGN="LEFT">state : character varying(10)</TD></TR><TR><TD ALIGN="LEFT">started_at : timestamp with time zone</TD></TR><TR><TD ALIGN="LEFT">heartbeat_at : timestamp with time zone</TD></TR><TR><TD ALIGN="LEFT">result_code : character varying(40) ?</TD></TR><TR><TD ALIGN="LEFT">completed_cycles : bigint</TD></TR></TABLE>>];
}