digraph WMS {
graph [rankdir=TB, bgcolor="white", nodesep=.5, ranksep=.9, pad=.3];
node [shape=plain, fontname="DejaVu Sans", fontsize=12];
edge [fontname="DejaVu Sans", fontsize=10, color="#334155", fontcolor="#334155", arrowsize=.8];
label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="20">Trạng thái chứng từ và điều kiện chuyển</FONT></TD></TR></TABLE>>; labelloc=t; fontname="DejaVu Sans"; fontsize=16;
"DRAFT" [shape=box, style="rounded,filled", fillcolor="#e3f1f8", label="DRAFT"];
"SUBMITTED" [shape=box, style="rounded,filled", fillcolor="#e3f1f8", label="SUBMITTED"];
"APPROVED" [shape=box, style="rounded,filled", fillcolor="#e3f1f8", label="APPROVED"];
"REJECTED" [shape=box, style="rounded,filled", fillcolor="#e3f1f8", label="REJECTED"];
"PARTIAL" [shape=box, style="rounded,filled", fillcolor="#e3f1f8", label="PARTIAL"];
"COMPLETED" [shape=box, style="rounded,filled", fillcolor="#e3f1f8", label="COMPLETED"];
"CANCELLED" [shape=box, style="rounded,filled", fillcolor="#e3f1f8", label="CANCELLED"];
"initial" [shape=circle, width=.2, height=.2, fixedsize=true, style=filled, fillcolor="#17384d", label=""];
"initial" -> "DRAFT" [label="create"];
"DRAFT" -> "SUBMITTED" [label="submit; kiểm tra dữ liệu"];
"REJECTED" -> "DRAFT" [label="Sửa nháp"];
"REJECTED" -> "SUBMITTED" [label="Gửi lại hợp lệ"];
"SUBMITTED" -> "APPROVED" [label="Đủ các bước duyệt"];
"SUBMITTED" -> "REJECTED" [label="Từ chối"];
"APPROVED" -> "DRAFT" [label="revise; hủy hiệu lực duyệt"];
"APPROVED" -> "PARTIAL" [label="Thực hiện một phần theo loại phiếu"];
"APPROVED" -> "COMPLETED" [label="Thực hiện đủ"];
"PARTIAL" -> "COMPLETED" [label="Thực hiện đủ / đóng phần còn lại hợp lệ"];
"DRAFT" -> "CANCELLED" [label="cancel trước thực hiện"];
"SUBMITTED" -> "CANCELLED" [label="cancel trước thực hiện"];
"REJECTED" -> "CANCELLED" [label="cancel trước thực hiện"];
"APPROVED" -> "CANCELLED" [label="cancel trước thực hiện"];
}