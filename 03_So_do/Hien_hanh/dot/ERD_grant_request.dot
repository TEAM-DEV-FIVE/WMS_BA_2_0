digraph WMS {
graph [rankdir=LR, bgcolor="white", nodesep=.32, ranksep=.6, pad=.28];
node [shape=plain, fontname="DejaVu Sans", fontsize=12];
edge [fontname="DejaVu Sans", fontsize=10, color="#567086", fontcolor="#334155", arrowsize=.7];
label="ERD hiện hành · grant_request"; labelloc=t; fontname="DejaVu Sans"; fontsize=20;
"grant_request" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>grant_request</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id : uuid</TD></TR><TR><TD ALIGN="LEFT">user_id : uuid</TD></TR><TR><TD ALIGN="LEFT">role_id : uuid</TD></TR><TR><TD ALIGN="LEFT">scope_kind : character varying(20)</TD></TR><TR><TD ALIGN="LEFT">warehouse_id : uuid ?</TD></TR><TR><TD ALIGN="LEFT">valid_until : timestamp with time zone ?</TD></TR><TR><TD ALIGN="LEFT">reason : text</TD></TR><TR><TD ALIGN="LEFT">requested_by : uuid</TD></TR><TR><TD ALIGN="LEFT">requested_at : timestamp with time zone</TD></TR><TR><TD ALIGN="LEFT">approved_by : uuid ?</TD></TR><TR><TD ALIGN="LEFT">grant_id : uuid ?</TD></TR></TABLE>>];
"app_user" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>app_user</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Bảng đích — các cột được tham chiếu</TD></TR><TR><TD ALIGN="LEFT">id : uuid</TD></TR></TABLE>>];
"user_role_grant" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>user_role_grant</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Bảng đích — các cột được tham chiếu</TD></TR><TR><TD ALIGN="LEFT">id : uuid</TD></TR></TABLE>>];
"role" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>role</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Bảng đích — các cột được tham chiếu</TD></TR><TR><TD ALIGN="LEFT">id : uuid</TD></TR></TABLE>>];
"warehouse" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>warehouse</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Bảng đích — các cột được tham chiếu</TD></TR><TR><TD ALIGN="LEFT">id : uuid</TD></TR></TABLE>>];
"grant_request" -> "app_user" [label="approved_by → id"];
"grant_request" -> "user_role_grant" [label="grant_id → id"];
"grant_request" -> "app_user" [label="requested_by → id"];
"grant_request" -> "role" [label="role_id → id"];
"grant_request" -> "app_user" [label="user_id → id"];
"grant_request" -> "warehouse" [label="warehouse_id → id"];
}