digraph WMS {
graph [rankdir=TB, bgcolor="white", nodesep=.32, ranksep=.6, pad=.28];
node [shape=plain, fontname="DejaVu Sans", fontsize=12];
edge [fontname="DejaVu Sans", fontsize=10, color="#567086", fontcolor="#334155", arrowsize=.7];
label="Các lớp desktop đang triển khai"; labelloc=t; fontname="DejaVu Sans"; fontsize=20;
"DesktopShell" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>DesktopShell</B></FONT></TD></TR><TR><TD ALIGN="LEFT">apps/desktop/views/shell.py</TD></TR><TR><TD ALIGN="LEFT">resize_header()</TD></TR><TR><TD ALIGN="LEFT">toggle_theme()</TD></TR><TR><TD ALIGN="LEFT">style_mapped_widget()</TD></TR><TR><TD ALIGN="LEFT">resize_workspace()</TD></TR><TR><TD ALIGN="LEFT">load_workspace()</TD></TR><TR><TD ALIGN="LEFT">open_key()</TD></TR><TR><TD ALIGN="LEFT">open_group()</TD></TR></TABLE>>];
"OrderView" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>OrderView</B></FONT></TD></TR><TR><TD ALIGN="LEFT">apps/desktop/views/orders.py</TD></TR><TR><TD ALIGN="LEFT">combo()</TD></TR><TR><TD ALIGN="LEFT">tree()</TD></TR><TR><TD ALIGN="LEFT">path()</TD></TR><TR><TD ALIGN="LEFT">warehouse_id()</TD></TR><TR><TD ALIGN="LEFT">session_changed()</TD></TR><TR><TD ALIGN="LEFT">scope_changed()</TD></TR><TR><TD ALIGN="LEFT">orders_clear()</TD></TR></TABLE>>];
"OrderPresenter" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>OrderPresenter</B></FONT></TD></TR><TR><TD ALIGN="LEFT">apps/desktop/presenters/orders.py</TD></TR><TR><TD ALIGN="LEFT">uncertain()</TD></TR><TR><TD ALIGN="LEFT">reset()</TD></TR><TR><TD ALIGN="LEFT">submit()</TD></TR><TR><TD ALIGN="LEFT">load()</TD></TR><TR><TD ALIGN="LEFT">read()</TD></TR><TR><TD ALIGN="LEFT">review()</TD></TR><TR><TD ALIGN="LEFT">candidates()</TD></TR></TABLE>>];
"IdentityClient" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>IdentityClient</B></FONT></TD></TR><TR><TD ALIGN="LEFT">apps/desktop/api/identity.py</TD></TR><TR><TD ALIGN="LEFT">enable_persistence()</TD></TR><TR><TD ALIGN="LEFT">persist_session()</TD></TR><TR><TD ALIGN="LEFT">restore_session()</TD></TR><TR><TD ALIGN="LEFT">file_request()</TD></TR><TR><TD ALIGN="LEFT">login()</TD></TR><TR><TD ALIGN="LEFT">mfa()</TD></TR><TR><TD ALIGN="LEFT">refresh()</TD></TR></TABLE>>];
"RecoveryJournal" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>RecoveryJournal</B></FONT></TD></TR><TR><TD ALIGN="LEFT">apps/desktop/local_store/recovery.py</TD></TR><TR><TD ALIGN="LEFT">work()</TD></TR><TR><TD ALIGN="LEFT">call()</TD></TR><TR><TD ALIGN="LEFT">close_store()</TD></TR><TR><TD ALIGN="LEFT">release()</TD></TR><TR><TD ALIGN="LEFT">close()</TD></TR></TABLE>>];
"CommandStore" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>CommandStore</B></FONT></TD></TR><TR><TD ALIGN="LEFT">apps/desktop/local_store/commands.py</TD></TR><TR><TD ALIGN="LEFT">checked()</TD></TR><TR><TD ALIGN="LEFT">prepare_command()</TD></TR><TR><TD ALIGN="LEFT">discard_draft()</TD></TR><TR><TD ALIGN="LEFT">edit_draft()</TD></TR><TR><TD ALIGN="LEFT">command_transition()</TD></TR><TR><TD ALIGN="LEFT">command_list()</TD></TR><TR><TD ALIGN="LEFT">cleanup()</TD></TR></TABLE>>];
{rank=same; "DesktopShell"; "OrderView"; "OrderPresenter";}
{rank=same; "IdentityClient"; "RecoveryJournal"; "CommandStore";}
"DesktopShell" -> "OrderView" [label="Khởi tạo / điều phối"];
"OrderView" -> "OrderPresenter" [label="Sự kiện UI"];
"OrderPresenter" -> "IdentityClient" [label="Gọi API qua executor"];
"IdentityClient" -> "RecoveryJournal" [label="Nhật ký phục hồi"];
"RecoveryJournal" -> "CommandStore" [label="Lưu lệnh cục bộ"];
}