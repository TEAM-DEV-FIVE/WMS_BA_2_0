digraph WMS {
graph [rankdir=TB, bgcolor="white", nodesep=.5, ranksep=.9, pad=.3];
node [shape=plain, fontname="DejaVu Sans", fontsize=12];
edge [fontname="DejaVu Sans", fontsize=10, color="#334155", fontcolor="#334155", arrowsize=.8];
label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="20">Các lớp desktop đang triển khai</FONT></TD></TR><TR><TD><FONT POINT-SIZE="10">Ch8 PDF 66–71 · UML implementation view · + công khai; − nội bộ theo quy ước Python</FONT></TD></TR><TR><TD><FONT POINT-SIZE="10">Lược chọn thành viên; kiểu chỉ ghi khi mã có annotation. Protocol được hiện thực theo cấu trúc.</FONT></TD></TR></TABLE>>; labelloc=t; fontname="DejaVu Sans"; fontsize=16;
"DesktopShell" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>DesktopShell</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+root: tk.Tk<BR ALIGN="LEFT"/>+settings: DesktopSettings<BR ALIGN="LEFT"/>+closed<BR ALIGN="LEFT"/>+closing<BR ALIGN="LEFT"/>+workers_stopped<BR ALIGN="LEFT"/>+restart_requested</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+resize_header(…)<BR ALIGN="LEFT"/>+toggle_theme(…)<BR ALIGN="LEFT"/>+style_mapped_widget(…)<BR ALIGN="LEFT"/>+resize_workspace(…)<BR ALIGN="LEFT"/>+load_workspace(…)<BR ALIGN="LEFT"/>+open_key(…)<BR ALIGN="LEFT"/>+open_group(…)</TD></TR></TABLE>>];
"OrderView" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>OrderView</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+presenter<BR ALIGN="LEFT"/>+variables<BR ALIGN="LEFT"/>+warehouses<BR ALIGN="LEFT"/>+permissions<BR ALIGN="LEFT"/>+catalog_ready<BR ALIGN="LEFT"/>+doc</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+combo(…)<BR ALIGN="LEFT"/>+tree(…)<BR ALIGN="LEFT"/>+path()<BR ALIGN="LEFT"/>+warehouse_id()<BR ALIGN="LEFT"/>+session_changed(…)<BR ALIGN="LEFT"/>+scope_changed(…)<BR ALIGN="LEFT"/>+orders_clear()</TD></TR></TABLE>>];
"OrderPresenter" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>OrderPresenter</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+view<BR ALIGN="LEFT"/>+api<BR ALIGN="LEFT"/>+executor<BR ALIGN="LEFT"/>+results<BR ALIGN="LEFT"/>+sequence<BR ALIGN="LEFT"/>+closed</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+uncertain()<BR ALIGN="LEFT"/>+reset(…)<BR ALIGN="LEFT"/>+submit(…)<BR ALIGN="LEFT"/>+load(…)<BR ALIGN="LEFT"/>+read(…)<BR ALIGN="LEFT"/>+review(…)<BR ALIGN="LEFT"/>+candidates(…)</TD></TR></TABLE>>];
"IdentityClient" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>IdentityClient</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+session_store<BR ALIGN="LEFT"/>+remember_session<BR ALIGN="LEFT"/>+persist_allowed<BR ALIGN="LEFT"/>+persistence_notice<BR ALIGN="LEFT"/>+settings<BR ALIGN="LEFT"/>+device_id</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+enable_persistence()<BR ALIGN="LEFT"/>+persist_session()<BR ALIGN="LEFT"/>+restore_session()<BR ALIGN="LEFT"/>+file_request(…)<BR ALIGN="LEFT"/>+login(…)<BR ALIGN="LEFT"/>+mfa(…)<BR ALIGN="LEFT"/>+refresh()</TD></TR></TABLE>>];
"RecoveryJournal" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>RecoveryJournal</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+settings<BR ALIGN="LEFT"/>+executor<BR ALIGN="LEFT"/>+store<BR ALIGN="LEFT"/>+partition</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+work(…)<BR ALIGN="LEFT"/>+call(…)<BR ALIGN="LEFT"/>+close_store()<BR ALIGN="LEFT"/>+release()<BR ALIGN="LEFT"/>+close()</TD></TR></TABLE>>];
"CommandStore" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>CommandStore</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+checked(…)<BR ALIGN="LEFT"/>+prepare_command(…)<BR ALIGN="LEFT"/>+discard_draft(…)<BR ALIGN="LEFT"/>+edit_draft(…)<BR ALIGN="LEFT"/>+command_transition(…)<BR ALIGN="LEFT"/>+command_list(…)<BR ALIGN="LEFT"/>+cleanup(…)</TD></TR></TABLE>>];
{rank=same; "DesktopShell"; "OrderView"; "OrderPresenter";}
{rank=same; "IdentityClient"; "RecoveryJournal"; "CommandStore";}
"DesktopShell" -> "OrderView" [label="Khởi tạo / điều phối", arrowhead="vee", style="dashed"];
"OrderView" -> "OrderPresenter" [label="Sự kiện UI", arrowhead="vee", style="dashed"];
"OrderPresenter" -> "IdentityClient" [label="Gọi API qua executor", arrowhead="vee", style="dashed"];
"IdentityClient" -> "RecoveryJournal" [label="Nhật ký phục hồi", arrowhead="vee", style="dashed"];
"RecoveryJournal" -> "CommandStore" [label="Lưu lệnh cục bộ", arrowhead="vee", style="dashed"];
}