digraph WMS {
graph [rankdir=LR, bgcolor="white", nodesep=.32, ranksep=.6, pad=.28];
node [shape=plain, fontname="DejaVu Sans", fontsize=12];
edge [fontname="DejaVu Sans", fontsize=10, color="#567086", fontcolor="#334155", arrowsize=.7];
label="ERD hiện hành · import_row"; labelloc=t; fontname="DejaVu Sans"; fontsize=20;
"import_row" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>import_row</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id : uuid</TD></TR><TR><TD ALIGN="LEFT">job_id : uuid</TD></TR><TR><TD ALIGN="LEFT">row_no : integer</TD></TR><TR><TD ALIGN="LEFT">payload : jsonb</TD></TR><TR><TD ALIGN="LEFT">errors : jsonb</TD></TR><TR><TD ALIGN="LEFT">target_id : uuid ?</TD></TR><TR><TD ALIGN="LEFT">status : character varying(20)</TD></TR></TABLE>>];
"import_job" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>import_job</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Bảng đích — các cột được tham chiếu</TD></TR><TR><TD ALIGN="LEFT">id : uuid</TD></TR></TABLE>>];
"import_row" -> "import_job" [label="job_id → id"];
}