digraph WMS {
graph [rankdir=TB, bgcolor="white", nodesep=.5, ranksep=.9, pad=.3];
node [shape=plain, fontname="DejaVu Sans", fontsize=12];
edge [fontname="DejaVu Sans", fontsize=10, color="#334155", fontcolor="#334155", arrowsize=.8];
label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="20">Vai trò và quyền seed · Kiểm soát/kế toán</FONT></TD></TR><TR><TD><FONT POINT-SIZE="10">RBAC · Vai trò và quyền seed sau migration 001–026</FONT></TD></TR></TABLE>>; labelloc=t; fontname="DejaVu Sans"; fontsize=16;
"role" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>Kiểm soát/kế toán</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">CONTROLLER</TD></TR></TABLE>>];
"group0" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>Quyền 1–7</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">adjustment.approve [WAREHOUSE]<BR ALIGN="LEFT"/>Duyệt điều chỉnh/đảo/mất hàng<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>adjustment.post [WAREHOUSE]<BR ALIGN="LEFT"/>Ghi điều chỉnh/đảo đã duyệt<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>audit.read [WAREHOUSE]<BR ALIGN="LEFT"/>Đọc audit nghiệp vụ<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>count.approve [WAREHOUSE]<BR ALIGN="LEFT"/>Duyệt kiểm kê hai bước<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>count.snapshot.read [WAREHOUSE]<BR ALIGN="LEFT"/>Xem số hệ thống và chênh lệch<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>document.approve [WAREHOUSE]<BR ALIGN="LEFT"/>Duyệt phiếu thông thường<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>document.read [WAREHOUSE]<BR ALIGN="LEFT"/>Xem chứng từ<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"group1" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>Quyền 8–14</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">import.commit [GLOBAL]<BR ALIGN="LEFT"/>Commit dữ liệu đã dry-run<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>import.validate [GLOBAL]<BR ALIGN="LEFT"/>Nạp staging và chạy dry-run<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>master.read [GLOBAL]<BR ALIGN="LEFT"/>Xem sản phẩm, UOM, barcode, nhóm<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>opening.approve [WAREHOUSE]<BR ALIGN="LEFT"/>Duyệt tồn đầu kỳ<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>opening.draft [WAREHOUSE]<BR ALIGN="LEFT"/>Lập/sửa/gửi duyệt Tồn đầu kỳ<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>opening.post [WAREHOUSE]<BR ALIGN="LEFT"/>Ghi tồn đầu kỳ đã duyệt<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>ownership.read [WAREHOUSE]<BR ALIGN="LEFT"/>Đọc phân tách tồn theo chủ sở hữu<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"group2" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>Quyền 15–21</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">partner.read [GLOBAL]<BR ALIGN="LEFT"/>Xem đối tác<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>period.close [WAREHOUSE]<BR ALIGN="LEFT"/>Khóa kỳ<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>period.create [WAREHOUSE]<BR ALIGN="LEFT"/>Mở kỳ kho<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>price.read [WAREHOUSE]<BR ALIGN="LEFT"/>Xem giá tham chiếu/giá trị<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>price.write [GLOBAL]<BR ALIGN="LEFT"/>Nhập giá tham chiếu mới<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>report.export [WAREHOUSE]<BR ALIGN="LEFT"/>Xuất báo cáo/tải file<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>report.read [WAREHOUSE]<BR ALIGN="LEFT"/>Xem 8 báo cáo định sẵn<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"group3" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>Quyền 22–25</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">return.unlinked [WAREHOUSE]<BR ALIGN="LEFT"/>Cho trả không có chứng từ gốc<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>serial.read [WAREHOUSE]<BR ALIGN="LEFT"/>Tra serial và nguồn bảo hành<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>stock.read [WAREHOUSE]<BR ALIGN="LEFT"/>Xem tồn và thẻ kho<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>warranty.write [WAREHOUSE]<BR ALIGN="LEFT"/>Ghi bổ sung chứng cứ bảo hành<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"role" -> "group0" [label=""];
"role" -> "group1" [label=""];
"role" -> "group2" [label=""];
"role" -> "group3" [label=""];
