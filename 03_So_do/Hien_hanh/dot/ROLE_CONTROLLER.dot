digraph WMS {
graph [rankdir=TB, bgcolor="white", nodesep=.32, ranksep=.6, pad=.28];
node [shape=plain, fontname="DejaVu Sans", fontsize=12];
edge [fontname="DejaVu Sans", fontsize=10, color="#567086", fontcolor="#334155", arrowsize=.7];
label="Vai trò và quyền seed · Kiểm soát/kế toán"; labelloc=t; fontname="DejaVu Sans"; fontsize=20;
"role" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>Kiểm soát/kế toán</B></FONT></TD></TR><TR><TD ALIGN="LEFT">CONTROLLER</TD></TR></TABLE>>];
"group0" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>Quyền 1–7</B></FONT></TD></TR><TR><TD ALIGN="LEFT">adjustment.approve [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Duyệt điều chỉnh/đảo/mất hàng</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">adjustment.post [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Ghi điều chỉnh/đảo đã duyệt</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">audit.read [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Đọc audit nghiệp vụ</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">count.approve [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Duyệt kiểm kê hai bước</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">count.snapshot.read [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Xem số hệ thống và chênh lệch</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">document.approve [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Duyệt phiếu thông thường</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">document.read [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Xem chứng từ</TD></TR><TR><TD ALIGN="LEFT"></TD></TR></TABLE>>];
"group1" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>Quyền 8–14</B></FONT></TD></TR><TR><TD ALIGN="LEFT">import.commit [GLOBAL]</TD></TR><TR><TD ALIGN="LEFT">Commit dữ liệu đã dry-run</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">import.validate [GLOBAL]</TD></TR><TR><TD ALIGN="LEFT">Nạp staging và chạy dry-run</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">master.read [GLOBAL]</TD></TR><TR><TD ALIGN="LEFT">Xem sản phẩm, UOM, barcode, nhóm</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">opening.approve [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Duyệt tồn đầu kỳ</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">opening.draft [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Lập/sửa/gửi duyệt Tồn đầu kỳ</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">opening.post [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Ghi tồn đầu kỳ đã duyệt</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">ownership.read [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Đọc phân tách tồn theo chủ sở hữu</TD></TR><TR><TD ALIGN="LEFT"></TD></TR></TABLE>>];
"group2" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>Quyền 15–21</B></FONT></TD></TR><TR><TD ALIGN="LEFT">partner.read [GLOBAL]</TD></TR><TR><TD ALIGN="LEFT">Xem đối tác</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">period.close [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Khóa kỳ</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">period.create [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Mở kỳ kho</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">price.read [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Xem giá tham chiếu/giá trị</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">price.write [GLOBAL]</TD></TR><TR><TD ALIGN="LEFT">Nhập giá tham chiếu mới</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">report.export [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Xuất báo cáo/tải file</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">report.read [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Xem 8 báo cáo định sẵn</TD></TR><TR><TD ALIGN="LEFT"></TD></TR></TABLE>>];
"group3" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>Quyền 22–25</B></FONT></TD></TR><TR><TD ALIGN="LEFT">return.unlinked [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Cho trả không có chứng từ gốc</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">serial.read [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Tra serial và nguồn bảo hành</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">stock.read [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Xem tồn và thẻ kho</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">warranty.write [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Ghi bổ sung chứng cứ bảo hành</TD></TR><TR><TD ALIGN="LEFT"></TD></TR></TABLE>>];
"role" -> "group0" [label=""];
"role" -> "group1" [label=""];
"role" -> "group2" [label=""];
"role" -> "group3" [label=""];
}