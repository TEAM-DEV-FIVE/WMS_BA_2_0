digraph WMS {
graph [rankdir=LR, bgcolor="white", nodesep=.32, ranksep=.6, pad=.28];
node [shape=plain, fontname="DejaVu Sans", fontsize=12];
edge [fontname="DejaVu Sans", fontsize=10, color="#567086", fontcolor="#334155", arrowsize=.7];
label="ERD hiện hành · custom_field_change"; labelloc=t; fontname="DejaVu Sans"; fontsize=20;
"custom_field_change" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>custom_field_change</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id : uuid</TD></TR><TR><TD ALIGN="LEFT">binding_id : uuid</TD></TR><TR><TD ALIGN="LEFT">revision_id : uuid</TD></TR><TR><TD ALIGN="LEFT">target_version : integer</TD></TR><TR><TD ALIGN="LEFT">values : jsonb</TD></TR><TR><TD ALIGN="LEFT">changed_by : uuid</TD></TR><TR><TD ALIGN="LEFT">changed_at : timestamp with time zone</TD></TR><TR><TD ALIGN="LEFT">reason : text</TD></TR></TABLE>>];
"custom_field_binding" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>custom_field_binding</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Bảng đích — các cột được tham chiếu</TD></TR><TR><TD ALIGN="LEFT">id : uuid</TD></TR></TABLE>>];
"app_user" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>app_user</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Bảng đích — các cột được tham chiếu</TD></TR><TR><TD ALIGN="LEFT">id : uuid</TD></TR></TABLE>>];
"custom_field_revision" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>custom_field_revision</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Bảng đích — các cột được tham chiếu</TD></TR><TR><TD ALIGN="LEFT">id : uuid</TD></TR></TABLE>>];
"custom_field_change" -> "custom_field_binding" [label="binding_id → id"];
"custom_field_change" -> "app_user" [label="changed_by → id"];
"custom_field_change" -> "custom_field_revision" [label="revision_id → id"];
}