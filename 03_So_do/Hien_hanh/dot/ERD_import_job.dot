digraph WMS {
graph [rankdir=LR, bgcolor="white", nodesep=.32, ranksep=.6, pad=.28];
node [shape=plain, fontname="DejaVu Sans", fontsize=12];
edge [fontname="DejaVu Sans", fontsize=10, color="#567086", fontcolor="#334155", arrowsize=.7];
label="ERD hiện hành · import_job"; labelloc=t; fontname="DejaVu Sans"; fontsize=20;
"import_job" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>import_job</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id : uuid</TD></TR><TR><TD ALIGN="LEFT">kind : character varying(60)</TD></TR><TR><TD ALIGN="LEFT">file_id : uuid</TD></TR><TR><TD ALIGN="LEFT">requested_by : uuid</TD></TR><TR><TD ALIGN="LEFT">status : character varying(20)</TD></TR><TR><TD ALIGN="LEFT">file_hash : character(64)</TD></TR><TR><TD ALIGN="LEFT">mapping_version : character varying(30)</TD></TR><TR><TD ALIGN="LEFT">operation_key : uuid</TD></TR><TR><TD ALIGN="LEFT">created_at : timestamp with time zone</TD></TR><TR><TD ALIGN="LEFT">warehouse_id : uuid ?</TD></TR><TR><TD ALIGN="LEFT">version : integer</TD></TR><TR><TD ALIGN="LEFT">generation : integer</TD></TR><TR><TD ALIGN="LEFT">auth_version : integer ?</TD></TR><TR><TD ALIGN="LEFT">options : jsonb</TD></TR><TR><TD ALIGN="LEFT">commit_token : uuid ?</TD></TR><TR><TD ALIGN="LEFT">token_expires_at : timestamp with time zone ?</TD></TR><TR><TD ALIGN="LEFT">stage_hash : character(64) ?</TD></TR><TR><TD ALIGN="LEFT">data_snapshot : jsonb</TD></TR><TR><TD ALIGN="LEFT">total_rows : integer</TD></TR><TR><TD ALIGN="LEFT">processed_rows : integer</TD></TR><TR><TD ALIGN="LEFT">errors : jsonb</TD></TR><TR><TD ALIGN="LEFT">result : jsonb ?</TD></TR></TABLE>>];
"stored_file" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>stored_file</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Bảng đích — các cột được tham chiếu</TD></TR><TR><TD ALIGN="LEFT">id : uuid</TD></TR></TABLE>>];
"app_user" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>app_user</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Bảng đích — các cột được tham chiếu</TD></TR><TR><TD ALIGN="LEFT">id : uuid</TD></TR></TABLE>>];
"warehouse" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>warehouse</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Bảng đích — các cột được tham chiếu</TD></TR><TR><TD ALIGN="LEFT">id : uuid</TD></TR></TABLE>>];
"import_job" -> "stored_file" [label="file_id → id"];
"import_job" -> "app_user" [label="requested_by → id"];
"import_job" -> "warehouse" [label="warehouse_id → id"];
}