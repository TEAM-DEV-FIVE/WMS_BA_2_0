digraph WMS {
graph [rankdir=LR, bgcolor="white", nodesep=.5, ranksep=.9, pad=.3];
node [shape=plain, fontname="DejaVu Sans", fontsize=12];
edge [fontname="DejaVu Sans", fontsize=10, color="#334155", fontcolor="#334155", arrowsize=.8];
label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="20">ERD · import_job</FONT></TD></TR><TR><TD><FONT POINT-SIZE="10">Ch8 PDF 48–52 · ERD vật lý / Crow’s Foot · PK: khóa chính; FK: khóa ngoại; ?: nullable</FONT></TD></TR><TR><TD><FONT POINT-SIZE="10">1: đúng một; 0..1: tùy chọn; 0..*: nhiều · Nét liền: FK thuộc PK; nét đứt: FK không định danh</FONT></TD></TR></TABLE>>; labelloc=t; fontname="DejaVu Sans"; fontsize=16;
"import_job" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>import_job</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PK id : uuid<BR ALIGN="LEFT"/>kind : character varying(60)<BR ALIGN="LEFT"/>FK file_id : uuid<BR ALIGN="LEFT"/>FK requested_by : uuid<BR ALIGN="LEFT"/>status : character varying(20)<BR ALIGN="LEFT"/>file_hash : character(64)<BR ALIGN="LEFT"/>mapping_version : character varying(30)<BR ALIGN="LEFT"/>operation_key : uuid<BR ALIGN="LEFT"/>created_at : timestamp with time zone<BR ALIGN="LEFT"/>FK warehouse_id : uuid ?<BR ALIGN="LEFT"/>version : integer<BR ALIGN="LEFT"/>generation : integer<BR ALIGN="LEFT"/>auth_version : integer ?<BR ALIGN="LEFT"/>options : jsonb<BR ALIGN="LEFT"/>commit_token : uuid ?<BR ALIGN="LEFT"/>token_expires_at : timestamp with time zone ?<BR ALIGN="LEFT"/>stage_hash : character(64) ?<BR ALIGN="LEFT"/>data_snapshot : jsonb<BR ALIGN="LEFT"/>total_rows : integer<BR ALIGN="LEFT"/>processed_rows : integer<BR ALIGN="LEFT"/>errors : jsonb<BR ALIGN="LEFT"/>result : jsonb ?</TD></TR></TABLE>>];
"stored_file" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>stored_file</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Bảng đích — các cột được tham chiếu<BR ALIGN="LEFT"/>id : uuid</TD></TR></TABLE>>];
"app_user" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>app_user</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Bảng đích — các cột được tham chiếu<BR ALIGN="LEFT"/>id : uuid</TD></TR></TABLE>>];
"warehouse" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>warehouse</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Bảng đích — các cột được tham chiếu<BR ALIGN="LEFT"/>id : uuid</TD></TR></TABLE>>];
"import_job" -> "stored_file" [label="file_id → id", dir="both", arrowtail="crowodot", arrowhead="teetee", taillabel="0..*", headlabel="1", labeldistance="2", style="dashed"];
"import_job" -> "app_user" [label="requested_by → id", dir="both", arrowtail="crowodot", arrowhead="teetee", taillabel="0..*", headlabel="1", labeldistance="2", style="dashed"];
"import_job" -> "warehouse" [label="warehouse_id → id", dir="both", arrowtail="crowodot", arrowhead="teeodot", taillabel="0..*", headlabel="0..1", labeldistance="2", style="dashed"];
}