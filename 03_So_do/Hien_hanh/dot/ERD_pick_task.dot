digraph WMS {
graph [rankdir=LR, bgcolor="white", nodesep=.32, ranksep=.6, pad=.28];
node [shape=plain, fontname="DejaVu Sans", fontsize=12];
edge [fontname="DejaVu Sans", fontsize=10, color="#567086", fontcolor="#334155", arrowsize=.7];
label="ERD hiện hành · pick_task"; labelloc=t; fontname="DejaVu Sans"; fontsize=20;
"pick_task" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>pick_task</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id : uuid</TD></TR><TR><TD ALIGN="LEFT">reservation_id : uuid</TD></TR><TR><TD ALIGN="LEFT">assigned_to : uuid</TD></TR><TR><TD ALIGN="LEFT">picked_quantity : numeric(20,6)</TD></TR><TR><TD ALIGN="LEFT">status : character varying(20)</TD></TR><TR><TD ALIGN="LEFT">version : integer</TD></TR><TR><TD ALIGN="LEFT">target_quantity : numeric(20,6) ?</TD></TR><TR><TD ALIGN="LEFT">consumed_quantity : numeric(20,6)</TD></TR><TR><TD ALIGN="LEFT">reason : text ?</TD></TR><TR><TD ALIGN="LEFT">created_by : uuid ?</TD></TR><TR><TD ALIGN="LEFT">created_at : timestamp with time zone ?</TD></TR></TABLE>>];
"app_user" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>app_user</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Bảng đích — các cột được tham chiếu</TD></TR><TR><TD ALIGN="LEFT">id : uuid</TD></TR></TABLE>>];
"reservation" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>reservation</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Bảng đích — các cột được tham chiếu</TD></TR><TR><TD ALIGN="LEFT">id : uuid</TD></TR></TABLE>>];
"pick_task" -> "app_user" [label="assigned_to → id"];
"pick_task" -> "app_user" [label="created_by → id"];
"pick_task" -> "reservation" [label="reservation_id → id"];
}