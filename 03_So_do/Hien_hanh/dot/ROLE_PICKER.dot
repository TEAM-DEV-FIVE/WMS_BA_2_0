digraph WMS {
graph [rankdir=TB, bgcolor="white", nodesep=.32, ranksep=.6, pad=.28];
node [shape=plain, fontname="DejaVu Sans", fontsize=12];
edge [fontname="DejaVu Sans", fontsize=10, color="#567086", fontcolor="#334155", arrowsize=.7];
label="Vai trò và quyền seed · Nhân viên soạn/xuất"; labelloc=t; fontname="DejaVu Sans"; fontsize=20;
"role" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>Nhân viên soạn/xuất</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PICKER</TD></TR></TABLE>>];
"group0" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>Quyền 1–7</B></FONT></TD></TR><TR><TD ALIGN="LEFT">count.enter [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Nhập số đếm/đếm lại</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">document.read [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Xem chứng từ</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">issue.draft [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Lập/sửa/gửi duyệt Phiếu xuất</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">issue.post [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Xác nhận xuất hàng</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">master.read [GLOBAL]</TD></TR><TR><TD ALIGN="LEFT">Xem sản phẩm, UOM, barcode, nhóm</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">move.draft [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Lập/sửa/gửi duyệt Chuyển vị trí</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">pick.confirm [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Xác nhận soạn/đóng gói</TD></TR><TR><TD ALIGN="LEFT"></TD></TR></TABLE>>];
"group1" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>Quyền 8–12</B></FONT></TD></TR><TR><TD ALIGN="LEFT">print.execute [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">In/in lại phiếu hoặc tem</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">reservation.manage [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Giữ/giải phóng hàng</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">serial.read [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Tra serial và nguồn bảo hành</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">stock.read [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Xem tồn và thẻ kho</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">transfer.dispatch [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Xuất chuyển từ kho nguồn</TD></TR><TR><TD ALIGN="LEFT"></TD></TR></TABLE>>];
"role" -> "group0" [label=""];
"role" -> "group1" [label=""];
}