digraph WMS {
graph [rankdir=TB, bgcolor="white", nodesep=.5, ranksep=.9, pad=.3];
node [shape=plain, fontname="DejaVu Sans", fontsize=12];
edge [fontname="DejaVu Sans", fontsize=10, color="#334155", fontcolor="#334155", arrowsize=.8];
label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="20">Vai trò và quyền · Nhân viên soạn/xuất</FONT></TD></TR></TABLE>>; labelloc=t; fontname="DejaVu Sans"; fontsize=16;
"role" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>Nhân viên soạn/xuất</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PICKER</TD></TR></TABLE>>];
"group0" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>Quyền 1–7</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">count.enter [WAREHOUSE]<BR ALIGN="LEFT"/>Nhập số đếm/đếm lại<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>document.read [WAREHOUSE]<BR ALIGN="LEFT"/>Xem chứng từ<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>issue.draft [WAREHOUSE]<BR ALIGN="LEFT"/>Lập/sửa/gửi duyệt Phiếu xuất<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>issue.post [WAREHOUSE]<BR ALIGN="LEFT"/>Xác nhận xuất hàng<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>master.read [GLOBAL]<BR ALIGN="LEFT"/>Xem sản phẩm, UOM, barcode, nhóm<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>move.draft [WAREHOUSE]<BR ALIGN="LEFT"/>Lập/sửa/gửi duyệt Chuyển vị trí<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>pick.confirm [WAREHOUSE]<BR ALIGN="LEFT"/>Xác nhận soạn/đóng gói<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"group1" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>Quyền 8–12</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">print.execute [WAREHOUSE]<BR ALIGN="LEFT"/>In/in lại phiếu hoặc tem<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>reservation.manage [WAREHOUSE]<BR ALIGN="LEFT"/>Giữ/giải phóng hàng<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>serial.read [WAREHOUSE]<BR ALIGN="LEFT"/>Tra serial và nguồn bảo hành<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>stock.read [WAREHOUSE]<BR ALIGN="LEFT"/>Xem tồn và thẻ kho<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>transfer.dispatch [WAREHOUSE]<BR ALIGN="LEFT"/>Xuất chuyển từ kho nguồn<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"role" -> "group0" [label=""];
"role" -> "group1" [label=""];
}