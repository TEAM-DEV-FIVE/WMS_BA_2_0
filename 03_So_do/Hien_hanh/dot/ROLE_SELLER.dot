digraph WMS {
graph [rankdir=TB, bgcolor="white", nodesep=.32, ranksep=.6, pad=.28];
node [shape=plain, fontname="DejaVu Sans", fontsize=12];
edge [fontname="DejaVu Sans", fontsize=10, color="#567086", fontcolor="#334155", arrowsize=.7];
label="Vai trò và quyền seed · Bán hàng"; labelloc=t; fontname="DejaVu Sans"; fontsize=20;
"role" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>Bán hàng</B></FONT></TD></TR><TR><TD ALIGN="LEFT">SELLER</TD></TR></TABLE>>];
"group0" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>Quyền 1–6</B></FONT></TD></TR><TR><TD ALIGN="LEFT">document.read [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Xem chứng từ</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">master.read [GLOBAL]</TD></TR><TR><TD ALIGN="LEFT">Xem sản phẩm, UOM, barcode, nhóm</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">partner.read [GLOBAL]</TD></TR><TR><TD ALIGN="LEFT">Xem đối tác</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">return.draft [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Lập/sửa/gửi duyệt Phiếu trả hàng</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">so.draft [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Lập/sửa/gửi duyệt Yêu cầu bán</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">stock.read [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Xem tồn và thẻ kho</TD></TR><TR><TD ALIGN="LEFT"></TD></TR></TABLE>>];
"role" -> "group0" [label=""];
}