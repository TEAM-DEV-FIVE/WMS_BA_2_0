digraph WMS {
graph [rankdir=LR, bgcolor="white", nodesep=.5, ranksep=.9, pad=.3];
node [shape=plain, fontname="DejaVu Sans", fontsize=12];
edge [fontname="DejaVu Sans", fontsize=10, color="#334155", fontcolor="#334155", arrowsize=.8];
label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="20">Các lớp xử lý lệnh trên máy chủ</FONT></TD></TR><TR><TD><FONT POINT-SIZE="10">Ch8 PDF 66–71 · UML implementation view · + công khai; − nội bộ theo quy ước Python</FONT></TD></TR><TR><TD><FONT POINT-SIZE="10">Lược chọn thành viên; kiểu chỉ ghi khi mã có annotation. Protocol được hiện thực theo cấu trúc.</FONT></TD></TR></TABLE>>; labelloc=t; fontname="DejaVu Sans"; fontsize=16;
"OrderService" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>OrderService</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+identity<BR ALIGN="LEFT"/>+bus</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+document(…)<BR ALIGN="LEFT"/>+may_edit(…)<BR ALIGN="LEFT"/>+listing(…)<BR ALIGN="LEFT"/>+lines(…)<BR ALIGN="LEFT"/>+snapshot(…)<BR ALIGN="LEFT"/>+approval(…)<BR ALIGN="LEFT"/>+approver(…)</TD></TR></TABLE>>];
"ReceiptService" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>ReceiptService</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+orders<BR ALIGN="LEFT"/>+identity<BR ALIGN="LEFT"/>+bus</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+source(…)<BR ALIGN="LEFT"/>+approved(…)<BR ALIGN="LEFT"/>+validate_saved(…)<BR ALIGN="LEFT"/>+may_post(…)<BR ALIGN="LEFT"/>+locations(…)<BR ALIGN="LEFT"/>+read(…)<BR ALIGN="LEFT"/>+validate_tracking(…)</TD></TR></TABLE>>];
"CommandBus" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>CommandBus</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+uow_factory: Callable[[], UnitOfWork]</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+execute(…): CommandResult</TD></TR></TABLE>>];
"PostgresUnitOfWork" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>PostgresUnitOfWork</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+engine: Engine</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+commit(): None<BR ALIGN="LEFT"/>+rollback(): None</TD></TR></TABLE>>];
"PostgresCommandRepository" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>PostgresCommandRepository</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+connection: Connection</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+lock(…): None<BR ALIGN="LEFT"/>+get(…): dict[str, Any] | None<BR ALIGN="LEFT"/>+save(…): None</TD></TR></TABLE>>];
"UnitOfWork" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>«protocol»<BR/>UnitOfWork</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+commands: CommandRepository</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+commit(): None<BR ALIGN="LEFT"/>+rollback(): None</TD></TR></TABLE>>];
"ReceiptService" -> "OrderService" [label="Dùng orders / identity / bus", arrowhead="vee", style="dashed"];
"OrderService" -> "CommandBus" [label="execute()", arrowhead="vee", style="dashed"];
"CommandBus" -> "UnitOfWork" [label="Giao diện transaction", arrowhead="vee", style="dashed"];
"PostgresUnitOfWork" -> "UnitOfWork" [label="Hiện thực giao thức", arrowhead="empty", style="dashed"];
"PostgresUnitOfWork" -> "PostgresCommandRepository" [label="commands", arrowhead="vee", style="dashed"];
}