digraph WMS {
graph [rankdir=LR, bgcolor="white", nodesep=.32, ranksep=.6, pad=.28];
node [shape=plain, fontname="DejaVu Sans", fontsize=12];
edge [fontname="DejaVu Sans", fontsize=10, color="#567086", fontcolor="#334155", arrowsize=.7];
label="ERD hiện hành · idempotency_record"; labelloc=t; fontname="DejaVu Sans"; fontsize=20;
"idempotency_record" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>idempotency_record</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id : uuid</TD></TR><TR><TD ALIGN="LEFT">actor_id : uuid</TD></TR><TR><TD ALIGN="LEFT">key : uuid</TD></TR><TR><TD ALIGN="LEFT">command : character varying(100)</TD></TR><TR><TD ALIGN="LEFT">request_hash : character(64)</TD></TR><TR><TD ALIGN="LEFT">response : jsonb</TD></TR><TR><TD ALIGN="LEFT">http_status : integer</TD></TR><TR><TD ALIGN="LEFT">completed_at : timestamp with time zone</TD></TR><TR><TD ALIGN="LEFT">expires_at : timestamp with time zone</TD></TR></TABLE>>];
"app_user" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>app_user</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Bảng đích — các cột được tham chiếu</TD></TR><TR><TD ALIGN="LEFT">id : uuid</TD></TR></TABLE>>];
"idempotency_record" -> "app_user" [label="actor_id → id"];
}