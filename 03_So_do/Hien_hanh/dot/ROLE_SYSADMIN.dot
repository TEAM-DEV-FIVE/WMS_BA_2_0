digraph WMS {
graph [rankdir=TB, bgcolor="white", nodesep=.32, ranksep=.6, pad=.28];
node [shape=plain, fontname="DejaVu Sans", fontsize=12];
edge [fontname="DejaVu Sans", fontsize=10, color="#567086", fontcolor="#334155", arrowsize=.7];
label="Vai trò và quyền seed · Quản trị kỹ thuật"; labelloc=t; fontname="DejaVu Sans"; fontsize=20;
"role" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>Quản trị kỹ thuật</B></FONT></TD></TR><TR><TD ALIGN="LEFT">SYSADMIN</TD></TR></TABLE>>];
"group0" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>Quyền 1–5</B></FONT></TD></TR><TR><TD ALIGN="LEFT">audit.security.read [GLOBAL]</TD></TR><TR><TD ALIGN="LEFT">Đọc audit tài khoản/quyền</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">backup.operate [GLOBAL]</TD></TR><TR><TD ALIGN="LEFT">Vận hành sao lưu/khôi phục</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">config.manage [GLOBAL]</TD></TR><TR><TD ALIGN="LEFT">Cấu hình máy chủ/client và policy kỹ</TD></TR><TR><TD ALIGN="LEFT">thuật</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">iam.manage [GLOBAL]</TD></TR><TR><TD ALIGN="LEFT">Quản lý user, khóa/thu hồi phiên</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">role.manage [GLOBAL]</TD></TR><TR><TD ALIGN="LEFT">Quản lý role và grant</TD></TR><TR><TD ALIGN="LEFT"></TD></TR></TABLE>>];
"role" -> "group0" [label=""];
}