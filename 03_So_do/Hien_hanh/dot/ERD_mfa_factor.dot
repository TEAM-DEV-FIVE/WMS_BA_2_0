digraph WMS {
graph [rankdir=LR, bgcolor="white", nodesep=.32, ranksep=.6, pad=.28];
node [shape=plain, fontname="DejaVu Sans", fontsize=12];
edge [fontname="DejaVu Sans", fontsize=10, color="#567086", fontcolor="#334155", arrowsize=.7];
label="ERD hiện hành · mfa_factor"; labelloc=t; fontname="DejaVu Sans"; fontsize=20;
"mfa_factor" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>mfa_factor</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id : uuid</TD></TR><TR><TD ALIGN="LEFT">user_id : uuid</TD></TR><TR><TD ALIGN="LEFT">kind : character varying(30)</TD></TR><TR><TD ALIGN="LEFT">credential_ciphertext : text</TD></TR><TR><TD ALIGN="LEFT">verified_at : timestamp with time zone ?</TD></TR><TR><TD ALIGN="LEFT">revoked_at : timestamp with time zone ?</TD></TR><TR><TD ALIGN="LEFT">last_counter : bigint</TD></TR><TR><TD ALIGN="LEFT">enrollment_expires_at : timestamp with time zone ?</TD></TR></TABLE>>];
"app_user" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>app_user</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Bảng đích — các cột được tham chiếu</TD></TR><TR><TD ALIGN="LEFT">id : uuid</TD></TR></TABLE>>];
"mfa_factor" -> "app_user" [label="user_id → id"];
}