digraph WMS {
graph [rankdir=LR, bgcolor="white", nodesep=.32, ranksep=.6, pad=.28];
node [shape=plain, fontname="DejaVu Sans", fontsize=12];
edge [fontname="DejaVu Sans", fontsize=10, color="#567086", fontcolor="#334155", arrowsize=.7];
label="Các hợp đồng dữ liệu và lỗi đang triển khai"; labelloc=t; fontname="DejaVu Sans"; fontsize=20;
"OrderAction" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>OrderAction</B></FONT></TD></TR><TR><TD ALIGN="LEFT">packages/contracts/orders.py</TD></TR><TR><TD ALIGN="LEFT">expected_version</TD></TR><TR><TD ALIGN="LEFT">reason</TD></TR></TABLE>>];
"ReceiptPost" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>ReceiptPost</B></FONT></TD></TR><TR><TD ALIGN="LEFT">packages/contracts/receipts.py</TD></TR><TR><TD ALIGN="LEFT">execution_key</TD></TR><TR><TD ALIGN="LEFT">lines</TD></TR><TR><TD ALIGN="LEFT">unique_lines()</TD></TR></TABLE>>];
"OrderView" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>OrderView</B></FONT></TD></TR><TR><TD ALIGN="LEFT">packages/contracts/orders.py</TD></TR><TR><TD ALIGN="LEFT">reason</TD></TR><TR><TD ALIGN="LEFT">lines</TD></TR><TR><TD ALIGN="LEFT">assigned_user_ids</TD></TR><TR><TD ALIGN="LEFT">approvals</TD></TR><TR><TD ALIGN="LEFT">allowed_actions</TD></TR></TABLE>>];
"ReceiptView" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>ReceiptView</B></FONT></TD></TR><TR><TD ALIGN="LEFT">packages/contracts/receipts.py</TD></TR><TR><TD ALIGN="LEFT">source_order_id</TD></TR><TR><TD ALIGN="LEFT">plan</TD></TR></TABLE>>];
"CommandResult" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>CommandResult</B></FONT></TD></TR><TR><TD ALIGN="LEFT">apps/server/application/commands.py</TD></TR><TR><TD ALIGN="LEFT">body</TD></TR><TR><TD ALIGN="LEFT">http_status</TD></TR></TABLE>>];
"DomainError" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>DomainError</B></FONT></TD></TR><TR><TD ALIGN="LEFT">apps/server/domain/errors.py</TD></TR></TABLE>>];
"ReceiptPost" -> "OrderAction" [label="Kế thừa"];
"ReceiptView" -> "OrderView" [label="Kế thừa"];
"ReceiptPost" -> "CommandResult" [label="Xử lý qua ReceiptService"];
}