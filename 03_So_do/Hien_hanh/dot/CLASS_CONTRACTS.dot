digraph WMS {
graph [rankdir=LR, bgcolor="white", nodesep=.5, ranksep=.9, pad=.3];
node [shape=plain, fontname="DejaVu Sans", fontsize=12];
edge [fontname="DejaVu Sans", fontsize=10, color="#334155", fontcolor="#334155", arrowsize=.8];
label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="20">Các hợp đồng dữ liệu và lỗi đang triển khai</FONT></TD></TR><TR><TD><FONT POINT-SIZE="10">Ch8 PDF 66–71 · UML implementation view · + công khai; − nội bộ theo quy ước Python</FONT></TD></TR><TR><TD><FONT POINT-SIZE="10">Lược chọn thành viên; kiểu chỉ ghi khi mã có annotation. Protocol được hiện thực theo cấu trúc.</FONT></TD></TR></TABLE>>; labelloc=t; fontname="DejaVu Sans"; fontsize=16;
"OrderAction" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>OrderAction</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+expected_version: int<BR ALIGN="LEFT"/>+reason: Reason</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
"ReceiptPost" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>ReceiptPost</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+execution_key: UUID<BR ALIGN="LEFT"/>+lines: list[PostLine]</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+unique_lines()</TD></TR></TABLE>>];
"OrderView" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>OrderView</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+reason: str | None<BR ALIGN="LEFT"/>+lines: list[OrderLineView]<BR ALIGN="LEFT"/>+assigned_user_ids: list[UUID]<BR ALIGN="LEFT"/>+approvals: list[ApprovalView]<BR ALIGN="LEFT"/>+allowed_actions: list[str]</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
"ReceiptView" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>ReceiptView</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+source_order_id: UUID<BR ALIGN="LEFT"/>+plan: list[ReceiptPlan]</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
"CommandResult" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>CommandResult</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+body: dict[str, Any]<BR ALIGN="LEFT"/>+http_status: int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
"DomainError" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>DomainError</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+code: str<BR ALIGN="LEFT"/>+message: str<BR ALIGN="LEFT"/>+retryable<BR ALIGN="LEFT"/>+field</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
"ReceiptPost" -> "OrderAction" [label="Kế thừa", arrowhead="empty", style="solid"];
"ReceiptView" -> "OrderView" [label="Kế thừa", arrowhead="empty", style="solid"];
}