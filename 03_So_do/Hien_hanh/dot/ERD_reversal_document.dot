digraph WMS {
graph [rankdir=LR, bgcolor="white", nodesep=.32, ranksep=.6, pad=.28];
node [shape=plain, fontname="DejaVu Sans", fontsize=12];
edge [fontname="DejaVu Sans", fontsize=10, color="#567086", fontcolor="#334155", arrowsize=.7];
label="ERD hiện hành · reversal_document"; labelloc=t; fontname="DejaVu Sans"; fontsize=20;
"reversal_document" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>reversal_document</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK document_id : uuid</TD></TR><TR><TD ALIGN="LEFT">source_transaction_id : uuid</TD></TR><TR><TD ALIGN="LEFT">source_version : integer</TD></TR><TR><TD ALIGN="LEFT">reversal_reason : text</TD></TR></TABLE>>];
"document" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>document</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Bảng đích — các cột được tham chiếu</TD></TR><TR><TD ALIGN="LEFT">id : uuid</TD></TR></TABLE>>];
"inventory_transaction" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>inventory_transaction</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Bảng đích — các cột được tham chiếu</TD></TR><TR><TD ALIGN="LEFT">id : uuid</TD></TR></TABLE>>];
"reversal_document" -> "document" [label="document_id → id"];
"reversal_document" -> "inventory_transaction" [label="source_transaction_id → id"];
}