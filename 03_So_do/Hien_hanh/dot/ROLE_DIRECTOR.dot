digraph WMS {
graph [rankdir=TB, bgcolor="white", nodesep=.5, ranksep=.9, pad=.3];
node [shape=plain, fontname="DejaVu Sans", fontsize=12];
edge [fontname="DejaVu Sans", fontsize=10, color="#334155", fontcolor="#334155", arrowsize=.8];
label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="20">Vai trò và quyền · Ban điều hành</FONT></TD></TR></TABLE>>; labelloc=t; fontname="DejaVu Sans"; fontsize=16;
"role" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>Ban điều hành</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">DIRECTOR</TD></TR></TABLE>>];
"group0" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>Quyền 1–7</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">count.approve [WAREHOUSE]<BR ALIGN="LEFT"/>Duyệt kiểm kê hai bước<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>count.snapshot.read [WAREHOUSE]<BR ALIGN="LEFT"/>Xem số hệ thống và chênh lệch<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>document.read [WAREHOUSE]<BR ALIGN="LEFT"/>Xem chứng từ<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>master.read [GLOBAL]<BR ALIGN="LEFT"/>Xem sản phẩm, UOM, barcode, nhóm<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>opening.approve [WAREHOUSE]<BR ALIGN="LEFT"/>Duyệt tồn đầu kỳ<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>ownership.read [WAREHOUSE]<BR ALIGN="LEFT"/>Đọc phân tách tồn theo chủ sở hữu<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>period.reopen [WAREHOUSE]<BR ALIGN="LEFT"/>Mở lại kỳ<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"group1" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>Quyền 8–12</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">price.read [WAREHOUSE]<BR ALIGN="LEFT"/>Xem giá tham chiếu/giá trị<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>report.export [WAREHOUSE]<BR ALIGN="LEFT"/>Xuất báo cáo/tải file<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>report.read [WAREHOUSE]<BR ALIGN="LEFT"/>Xem 8 báo cáo định sẵn<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>serial.read [WAREHOUSE]<BR ALIGN="LEFT"/>Tra serial và nguồn bảo hành<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>stock.read [WAREHOUSE]<BR ALIGN="LEFT"/>Xem tồn và thẻ kho<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"role" -> "group0" [label=""];
"role" -> "group1" [label=""];
}