digraph WMS {
graph [rankdir=TB, bgcolor="white", nodesep=.32, ranksep=.6, pad=.28];
node [shape=plain, fontname="DejaVu Sans", fontsize=12];
edge [fontname="DejaVu Sans", fontsize=10, color="#567086", fontcolor="#334155", arrowsize=.7];
label="Vai trò và quyền seed · Ban điều hành"; labelloc=t; fontname="DejaVu Sans"; fontsize=20;
"role" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>Ban điều hành</B></FONT></TD></TR><TR><TD ALIGN="LEFT">DIRECTOR</TD></TR></TABLE>>];
"group0" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>Quyền 1–7</B></FONT></TD></TR><TR><TD ALIGN="LEFT">count.approve [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Duyệt kiểm kê hai bước</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">count.snapshot.read [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Xem số hệ thống và chênh lệch</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">document.read [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Xem chứng từ</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">master.read [GLOBAL]</TD></TR><TR><TD ALIGN="LEFT">Xem sản phẩm, UOM, barcode, nhóm</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">opening.approve [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Duyệt tồn đầu kỳ</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">ownership.read [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Đọc phân tách tồn theo chủ sở hữu</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">period.reopen [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Mở lại kỳ</TD></TR><TR><TD ALIGN="LEFT"></TD></TR></TABLE>>];
"group1" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>Quyền 8–12</B></FONT></TD></TR><TR><TD ALIGN="LEFT">price.read [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Xem giá tham chiếu/giá trị</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">report.export [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Xuất báo cáo/tải file</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">report.read [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Xem 8 báo cáo định sẵn</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">serial.read [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Tra serial và nguồn bảo hành</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">stock.read [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Xem tồn và thẻ kho</TD></TR><TR><TD ALIGN="LEFT"></TD></TR></TABLE>>];
"role" -> "group0" [label=""];
"role" -> "group1" [label=""];
}