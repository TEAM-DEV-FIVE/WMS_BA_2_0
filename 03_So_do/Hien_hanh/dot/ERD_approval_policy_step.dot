digraph WMS {
graph [rankdir=LR, bgcolor="white", nodesep=.32, ranksep=.6, pad=.28];
node [shape=plain, fontname="DejaVu Sans", fontsize=12];
edge [fontname="DejaVu Sans", fontsize=10, color="#567086", fontcolor="#334155", arrowsize=.7];
label="ERD hiện hành · approval_policy_step"; labelloc=t; fontname="DejaVu Sans"; fontsize=20;
"approval_policy_step" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>approval_policy_step</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id : uuid</TD></TR><TR><TD ALIGN="LEFT">policy_id : uuid</TD></TR><TR><TD ALIGN="LEFT">step_no : integer</TD></TR><TR><TD ALIGN="LEFT">role_id : uuid</TD></TR><TR><TD ALIGN="LEFT">alternative_role_id : uuid ?</TD></TR></TABLE>>];
"role" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>role</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Bảng đích — các cột được tham chiếu</TD></TR><TR><TD ALIGN="LEFT">id : uuid</TD></TR></TABLE>>];
"approval_policy" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>approval_policy</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Bảng đích — các cột được tham chiếu</TD></TR><TR><TD ALIGN="LEFT">id : uuid</TD></TR></TABLE>>];
"approval_policy_step" -> "role" [label="alternative_role_id → id"];
"approval_policy_step" -> "approval_policy" [label="policy_id → id"];
"approval_policy_step" -> "role" [label="role_id → id"];
}