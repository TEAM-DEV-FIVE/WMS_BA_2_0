digraph WMS {
graph [rankdir=TB, bgcolor="white", nodesep=.32, ranksep=.6, pad=.28];
node [shape=plain, fontname="DejaVu Sans", fontsize=12];
edge [fontname="DejaVu Sans", fontsize=10, color="#567086", fontcolor="#334155", arrowsize=.7];
label="Luồng giữ hàng và xuất kho"; labelloc=t; fontname="DejaVu Sans"; fontsize=20;
"n0" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>SO đã được duyệt</B></FONT></TD></TR></TABLE>>];
"n1" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>Lập, gửi duyệt và duyệt phiếu xuất</B></FONT></TD></TR></TABLE>>];
"n2" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>Giữ số lượng khả dụng</B></FONT></TD></TR></TABLE>>];
"n3" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>Soạn hàng và đóng kiện theo tác vụ</B></FONT></TD></TR></TABLE>>];
"n4" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>Ghi sổ xuất theo dòng hợp lệ</B></FONT></TD></TR></TABLE>>];
"n0" -> "n1" [label=""];
"n1" -> "n2" [label=""];
"n2" -> "n3" [label=""];
"n3" -> "n4" [label=""];
}