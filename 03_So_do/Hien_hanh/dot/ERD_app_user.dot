digraph WMS {
graph [rankdir=LR, bgcolor="white", nodesep=.32, ranksep=.6, pad=.28];
node [shape=plain, fontname="DejaVu Sans", fontsize=12];
edge [fontname="DejaVu Sans", fontsize=10, color="#567086", fontcolor="#334155", arrowsize=.7];
label="ERD hiện hành · app_user"; labelloc=t; fontname="DejaVu Sans"; fontsize=20;
"app_user" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>app_user</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id : uuid</TD></TR><TR><TD ALIGN="LEFT">username : character varying(100)</TD></TR><TR><TD ALIGN="LEFT">display_name : character varying(200)</TD></TR><TR><TD ALIGN="LEFT">password_hash : text</TD></TR><TR><TD ALIGN="LEFT">is_active : boolean</TD></TR><TR><TD ALIGN="LEFT">auth_version : integer</TD></TR><TR><TD ALIGN="LEFT">created_at : timestamp with time zone</TD></TR></TABLE>>];
}