digraph WMS {
graph [rankdir=LR, bgcolor="white", nodesep=.32, ranksep=.6, pad=.28];
node [shape=plain, fontname="DejaVu Sans", fontsize=12];
edge [fontname="DejaVu Sans", fontsize=10, color="#567086", fontcolor="#334155", arrowsize=.7];
label="ERD hiện hành · transfer_move"; labelloc=t; fontname="DejaVu Sans"; fontsize=20;
"transfer_move" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>transfer_move</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK move_id : uuid</TD></TR><TR><TD ALIGN="LEFT">dispatch_move_id : uuid ?</TD></TR><TR><TD ALIGN="LEFT">disposition : character varying(20)</TD></TR><TR><TD ALIGN="LEFT">evidence_ref : character varying(2000)</TD></TR></TABLE>>];
"stock_move" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>stock_move</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Bảng đích — các cột được tham chiếu</TD></TR><TR><TD ALIGN="LEFT">id : uuid</TD></TR></TABLE>>];
"transfer_move" -> "stock_move" [label="dispatch_move_id → id"];
"transfer_move" -> "stock_move" [label="move_id → id"];
}