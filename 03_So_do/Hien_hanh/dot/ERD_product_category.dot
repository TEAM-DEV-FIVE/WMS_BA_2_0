digraph WMS {
graph [rankdir=LR, bgcolor="white", nodesep=.32, ranksep=.6, pad=.28];
node [shape=plain, fontname="DejaVu Sans", fontsize=12];
edge [fontname="DejaVu Sans", fontsize=10, color="#567086", fontcolor="#334155", arrowsize=.7];
label="ERD hiện hành · product_category"; labelloc=t; fontname="DejaVu Sans"; fontsize=20;
"product_category" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>product_category</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id : uuid</TD></TR><TR><TD ALIGN="LEFT">code : character varying(40)</TD></TR><TR><TD ALIGN="LEFT">name : character varying(160)</TD></TR><TR><TD ALIGN="LEFT">parent_id : uuid ?</TD></TR><TR><TD ALIGN="LEFT">version : integer</TD></TR><TR><TD ALIGN="LEFT">is_active : boolean</TD></TR></TABLE>>];
"product_category" -> "product_category" [label="parent_id → id"];
}