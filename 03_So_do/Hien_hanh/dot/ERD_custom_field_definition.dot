digraph WMS {
graph [rankdir=LR, bgcolor="white", nodesep=.5, ranksep=.9, pad=.3];
node [shape=plain, fontname="DejaVu Sans", fontsize=12];
edge [fontname="DejaVu Sans", fontsize=10, color="#334155", fontcolor="#334155", arrowsize=.8];
label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="20">ERD · custom_field_definition</FONT></TD></TR></TABLE>>; labelloc=t; fontname="DejaVu Sans"; fontsize=16;
"custom_field_definition" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>custom_field_definition</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PK id : uuid<BR ALIGN="LEFT"/>entity_type : character varying(40)<BR ALIGN="LEFT"/>code : character varying(60)<BR ALIGN="LEFT"/>value_type : character varying(20)<BR ALIGN="LEFT"/>required : boolean<BR ALIGN="LEFT"/>validation : jsonb<BR ALIGN="LEFT"/>is_active : boolean<BR ALIGN="LEFT"/>FK revision_id : uuid ?<BR ALIGN="LEFT"/>label : character varying(120) ?<BR ALIGN="LEFT"/>visibility : character varying(20)</TD></TR></TABLE>>];
"custom_field_revision" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>custom_field_revision</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Bảng đích — các cột được tham chiếu<BR ALIGN="LEFT"/>id : uuid</TD></TR></TABLE>>];
"custom_field_definition" -> "custom_field_revision" [label="revision_id → id", dir="both", arrowtail="crowodot", arrowhead="teeodot", taillabel="0..*", headlabel="0..1", labeldistance="2", style="dashed"];
}