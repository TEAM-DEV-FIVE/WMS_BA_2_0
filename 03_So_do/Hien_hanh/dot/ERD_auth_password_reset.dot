digraph WMS {
graph [rankdir=LR, bgcolor="white", nodesep=.5, ranksep=.9, pad=.3];
node [shape=plain, fontname="DejaVu Sans", fontsize=12];
edge [fontname="DejaVu Sans", fontsize=10, color="#334155", fontcolor="#334155", arrowsize=.8];
label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="20">ERD · auth_password_reset</FONT></TD></TR><TR><TD><FONT POINT-SIZE="10">Ch8 PDF 48–52 · ERD vật lý / Crow’s Foot · PK: khóa chính; FK: khóa ngoại; ?: nullable</FONT></TD></TR><TR><TD><FONT POINT-SIZE="10">1: đúng một; 0..1: tùy chọn; 0..*: nhiều · Nét liền: FK thuộc PK; nét đứt: FK không định danh</FONT></TD></TR></TABLE>>; labelloc=t; fontname="DejaVu Sans"; fontsize=16;
"auth_password_reset" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>auth_password_reset</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PK token_hash : character(64)<BR ALIGN="LEFT"/>FK user_id : uuid<BR ALIGN="LEFT"/>FK issued_by : uuid<BR ALIGN="LEFT"/>auth_version : integer<BR ALIGN="LEFT"/>created_at : timestamp with time zone<BR ALIGN="LEFT"/>expires_at : timestamp with time zone<BR ALIGN="LEFT"/>consumed_at : timestamp with time zone ?</TD></TR></TABLE>>];
"app_user" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>app_user</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Bảng đích — các cột được tham chiếu<BR ALIGN="LEFT"/>id : uuid</TD></TR></TABLE>>];
"auth_password_reset" -> "app_user" [label="issued_by → id", dir="both", arrowtail="crowodot", arrowhead="teetee", taillabel="0..*", headlabel="1", labeldistance="2", style="dashed"];
"auth_password_reset" -> "app_user" [label="user_id → id", dir="both", arrowtail="crowodot", arrowhead="teetee", taillabel="0..*", headlabel="1", labeldistance="2", style="dashed"];
}