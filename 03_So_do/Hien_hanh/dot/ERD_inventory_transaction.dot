digraph WMS {
graph [rankdir=LR, bgcolor="white", nodesep=.32, ranksep=.6, pad=.28];
node [shape=plain, fontname="DejaVu Sans", fontsize=12];
edge [fontname="DejaVu Sans", fontsize=10, color="#567086", fontcolor="#334155", arrowsize=.7];
label="ERD hiện hành · inventory_transaction"; labelloc=t; fontname="DejaVu Sans"; fontsize=20;
"inventory_transaction" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>inventory_transaction</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id : uuid</TD></TR><TR><TD ALIGN="LEFT">document_id : uuid</TD></TR><TR><TD ALIGN="LEFT">execution_key : uuid</TD></TR><TR><TD ALIGN="LEFT">operation : character varying(30)</TD></TR><TR><TD ALIGN="LEFT">business_date : date</TD></TR><TR><TD ALIGN="LEFT">posted_at : timestamp with time zone</TD></TR><TR><TD ALIGN="LEFT">posted_by : uuid</TD></TR><TR><TD ALIGN="LEFT">reverses_transaction_id : uuid ?</TD></TR><TR><TD ALIGN="LEFT">request_hash : character(64) ?</TD></TR><TR><TD ALIGN="LEFT">response : jsonb ?</TD></TR></TABLE>>];
"document" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>document</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Bảng đích — các cột được tham chiếu</TD></TR><TR><TD ALIGN="LEFT">id : uuid</TD></TR></TABLE>>];
"app_user" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>app_user</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Bảng đích — các cột được tham chiếu</TD></TR><TR><TD ALIGN="LEFT">id : uuid</TD></TR></TABLE>>];
"inventory_transaction" -> "document" [label="document_id → id"];
"inventory_transaction" -> "app_user" [label="posted_by → id"];
"inventory_transaction" -> "inventory_transaction" [label="reverses_transaction_id → id"];
}