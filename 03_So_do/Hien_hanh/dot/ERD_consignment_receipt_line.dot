digraph WMS {
graph [rankdir=LR, bgcolor="white", nodesep=.32, ranksep=.6, pad=.28];
node [shape=plain, fontname="DejaVu Sans", fontsize=12];
edge [fontname="DejaVu Sans", fontsize=10, color="#567086", fontcolor="#334155", arrowsize=.7];
label="ERD hiện hành · consignment_receipt_line"; labelloc=t; fontname="DejaVu Sans"; fontsize=20;
"consignment_receipt_line" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>consignment_receipt_line</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK document_line_id : uuid</TD></TR><TR><TD ALIGN="LEFT">destination_location_id : uuid</TD></TR><TR><TD ALIGN="LEFT">lot_code : character varying(100) ?</TD></TR><TR><TD ALIGN="LEFT">serial_code : character varying(160) ?</TD></TR><TR><TD ALIGN="LEFT">manufactured_on : date ?</TD></TR><TR><TD ALIGN="LEFT">expires_on : date ?</TD></TR></TABLE>>];
"location" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>location</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Bảng đích — các cột được tham chiếu</TD></TR><TR><TD ALIGN="LEFT">id : uuid</TD></TR></TABLE>>];
"document_line" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>document_line</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Bảng đích — các cột được tham chiếu</TD></TR><TR><TD ALIGN="LEFT">id : uuid</TD></TR></TABLE>>];
"consignment_receipt_line" -> "location" [label="destination_location_id → id"];
"consignment_receipt_line" -> "document_line" [label="document_line_id → id"];
}