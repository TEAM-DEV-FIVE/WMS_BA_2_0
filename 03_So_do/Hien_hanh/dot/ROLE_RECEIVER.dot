digraph WMS {
graph [rankdir=TB, bgcolor="white", nodesep=.5, ranksep=.9, pad=.3];
node [shape=plain, fontname="DejaVu Sans", fontsize=12];
edge [fontname="DejaVu Sans", fontsize=10, color="#334155", fontcolor="#334155", arrowsize=.8];
label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="20">Vai trò và quyền seed · Nhân viên nhận</FONT></TD></TR><TR><TD><FONT POINT-SIZE="10">RBAC · Vai trò và quyền seed sau migration 001–026</FONT></TD></TR></TABLE>>; labelloc=t; fontname="DejaVu Sans"; fontsize=16;
"role" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>Nhân viên nhận</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">RECEIVER</TD></TR></TABLE>>];
"group0" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>Quyền 1–7</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">count.enter [WAREHOUSE]<BR ALIGN="LEFT"/>Nhập số đếm/đếm lại<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>document.read [WAREHOUSE]<BR ALIGN="LEFT"/>Xem chứng từ<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>master.read [GLOBAL]<BR ALIGN="LEFT"/>Xem sản phẩm, UOM, barcode, nhóm<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>move.draft [WAREHOUSE]<BR ALIGN="LEFT"/>Lập/sửa/gửi duyệt Chuyển vị trí<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>move.post [WAREHOUSE]<BR ALIGN="LEFT"/>Ghi sổ chuyển vị trí/cất hàng<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>print.execute [WAREHOUSE]<BR ALIGN="LEFT"/>In/in lại phiếu hoặc tem<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>receipt.draft [WAREHOUSE]<BR ALIGN="LEFT"/>Lập/sửa/gửi duyệt Phiếu nhận<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"group1" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>Quyền 8–12</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">receipt.post [WAREHOUSE]<BR ALIGN="LEFT"/>Ghi nhận hàng thực nhận<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>return.draft [WAREHOUSE]<BR ALIGN="LEFT"/>Lập/sửa/gửi duyệt Phiếu trả hàng<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>serial.read [WAREHOUSE]<BR ALIGN="LEFT"/>Tra serial và nguồn bảo hành<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>stock.read [WAREHOUSE]<BR ALIGN="LEFT"/>Xem tồn và thẻ kho<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>transfer.receive [WAREHOUSE]<BR ALIGN="LEFT"/>Nhận chuyển tại kho đích<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"role" -> "group0" [label=""];
