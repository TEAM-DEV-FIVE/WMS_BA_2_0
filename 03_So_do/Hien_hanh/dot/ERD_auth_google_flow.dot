digraph WMS {
graph [rankdir=LR, bgcolor="white", nodesep=.5, ranksep=.9, pad=.3];
node [shape=plain, fontname="DejaVu Sans", fontsize=12];
edge [fontname="DejaVu Sans", fontsize=10, color="#334155", fontcolor="#334155", arrowsize=.8];
label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="20">ERD · auth_google_flow</FONT></TD></TR></TABLE>>; labelloc=t; fontname="DejaVu Sans"; fontsize=16;
"auth_google_flow" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>auth_google_flow</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PK state_hash : character(64)<BR ALIGN="LEFT"/>nonce_hash : character(64)<BR ALIGN="LEFT"/>verifier_ciphertext : text ?<BR ALIGN="LEFT"/>redirect_uri : text<BR ALIGN="LEFT"/>device_id : uuid<BR ALIGN="LEFT"/>FK user_id : uuid ?<BR ALIGN="LEFT"/>FK session_id : uuid ?<BR ALIGN="LEFT"/>auth_version : integer ?<BR ALIGN="LEFT"/>expires_at : timestamp with time zone<BR ALIGN="LEFT"/>consumed_at : timestamp with time zone ?</TD></TR></TABLE>>];
"auth_session" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>auth_session</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Bảng đích — các cột được tham chiếu<BR ALIGN="LEFT"/>id : uuid</TD></TR></TABLE>>];
"app_user" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>app_user</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Bảng đích — các cột được tham chiếu<BR ALIGN="LEFT"/>id : uuid</TD></TR></TABLE>>];
"auth_google_flow" -> "auth_session" [label="session_id → id", dir="both", arrowtail="crowodot", arrowhead="teeodot", taillabel="0..*", headlabel="0..1", labeldistance="2", style="dashed"];
"auth_google_flow" -> "app_user" [label="user_id → id", dir="both", arrowtail="crowodot", arrowhead="teeodot", taillabel="0..*", headlabel="0..1", labeldistance="2", style="dashed"];
}