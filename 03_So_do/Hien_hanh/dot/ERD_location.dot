digraph WMS {
graph [rankdir=LR, bgcolor="white", nodesep=.32, ranksep=.6, pad=.28];
node [shape=plain, fontname="DejaVu Sans", fontsize=12];
edge [fontname="DejaVu Sans", fontsize=10, color="#567086", fontcolor="#334155", arrowsize=.7];
label="ERD hiện hành · location"; labelloc=t; fontname="DejaVu Sans"; fontsize=20;
"location" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>location</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id : uuid</TD></TR><TR><TD ALIGN="LEFT">warehouse_id : uuid ?</TD></TR><TR><TD ALIGN="LEFT">parent_id : uuid ?</TD></TR><TR><TD ALIGN="LEFT">code : character varying(80)</TD></TR><TR><TD ALIGN="LEFT">name : character varying(160)</TD></TR><TR><TD ALIGN="LEFT">kind : character varying(20)</TD></TR><TR><TD ALIGN="LEFT">is_active : boolean</TD></TR><TR><TD ALIGN="LEFT">version : integer</TD></TR></TABLE>>];
"warehouse" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>warehouse</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Bảng đích — các cột được tham chiếu</TD></TR><TR><TD ALIGN="LEFT">id : uuid</TD></TR></TABLE>>];
"location" -> "location" [label="parent_id → id"];
"location" -> "warehouse" [label="warehouse_id → id"];
}