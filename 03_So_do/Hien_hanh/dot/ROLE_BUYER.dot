digraph WMS {
graph [rankdir=TB, bgcolor="white", nodesep=.5, ranksep=.9, pad=.3];
node [shape=plain, fontname="DejaVu Sans", fontsize=12];
edge [fontname="DejaVu Sans", fontsize=10, color="#334155", fontcolor="#334155", arrowsize=.8];
label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="20">Vai trò và quyền · Mua hàng</FONT></TD></TR></TABLE>>; labelloc=t; fontname="DejaVu Sans"; fontsize=16;
"role" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>Mua hàng</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">BUYER</TD></TR></TABLE>>];
"group0" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>Quyền 1–6</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">document.read [WAREHOUSE]<BR ALIGN="LEFT"/>Xem chứng từ<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>master.read [GLOBAL]<BR ALIGN="LEFT"/>Xem sản phẩm, UOM, barcode, nhóm<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>partner.read [GLOBAL]<BR ALIGN="LEFT"/>Xem đối tác<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>po.draft [WAREHOUSE]<BR ALIGN="LEFT"/>Lập/sửa/gửi duyệt Yêu cầu mua<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>return.draft [WAREHOUSE]<BR ALIGN="LEFT"/>Lập/sửa/gửi duyệt Phiếu trả hàng<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>stock.read [WAREHOUSE]<BR ALIGN="LEFT"/>Xem tồn và thẻ kho<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"role" -> "group0" [label=""];
}