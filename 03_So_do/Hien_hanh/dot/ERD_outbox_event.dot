digraph WMS {
graph [rankdir=LR, bgcolor="white", nodesep=.32, ranksep=.6, pad=.28];
node [shape=plain, fontname="DejaVu Sans", fontsize=12];
edge [fontname="DejaVu Sans", fontsize=10, color="#567086", fontcolor="#334155", arrowsize=.7];
label="ERD hiện hành · outbox_event"; labelloc=t; fontname="DejaVu Sans"; fontsize=20;
"outbox_event" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>outbox_event</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id : uuid</TD></TR><TR><TD ALIGN="LEFT">event_type : character varying(100)</TD></TR><TR><TD ALIGN="LEFT">aggregate_id : uuid</TD></TR><TR><TD ALIGN="LEFT">payload : jsonb</TD></TR><TR><TD ALIGN="LEFT">occurred_at : timestamp with time zone</TD></TR><TR><TD ALIGN="LEFT">available_at : timestamp with time zone</TD></TR><TR><TD ALIGN="LEFT">attempts : integer</TD></TR><TR><TD ALIGN="LEFT">processed_at : timestamp with time zone ?</TD></TR><TR><TD ALIGN="LEFT">last_error : text ?</TD></TR><TR><TD ALIGN="LEFT">version : integer</TD></TR><TR><TD ALIGN="LEFT">replay_count : integer</TD></TR><TR><TD ALIGN="LEFT">replayed_at : timestamp with time zone ?</TD></TR></TABLE>>];
}