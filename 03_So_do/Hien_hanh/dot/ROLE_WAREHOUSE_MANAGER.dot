digraph WMS {
graph [rankdir=TB, bgcolor="white", nodesep=.5, ranksep=.9, pad=.3];
node [shape=plain, fontname="DejaVu Sans", fontsize=12];
edge [fontname="DejaVu Sans", fontsize=10, color="#334155", fontcolor="#334155", arrowsize=.8];
label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="20">Vai trò và quyền · Quản lý kho</FONT></TD></TR></TABLE>>; labelloc=t; fontname="DejaVu Sans"; fontsize=16;
"role" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>Quản lý kho</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">WAREHOUSE_MANAGER</TD></TR></TABLE>>];
"group0" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>Quyền 1–7</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">adjustment.draft [WAREHOUSE]<BR ALIGN="LEFT"/>Lập/sửa/gửi duyệt Điều chỉnh<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>count.create [WAREHOUSE]<BR ALIGN="LEFT"/>Tạo phiên và khóa vị trí kiểm kê<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>count.enter [WAREHOUSE]<BR ALIGN="LEFT"/>Nhập số đếm/đếm lại<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>count.snapshot.read [WAREHOUSE]<BR ALIGN="LEFT"/>Xem số hệ thống và chênh lệch<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>count.submit [WAREHOUSE]<BR ALIGN="LEFT"/>Chọn kết quả và trình điều chỉnh<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>document.approve [WAREHOUSE]<BR ALIGN="LEFT"/>Duyệt phiếu thông thường<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>document.assign [WAREHOUSE]<BR ALIGN="LEFT"/>Phân công phiếu<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"group1" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>Quyền 8–14</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">document.cancel [WAREHOUSE]<BR ALIGN="LEFT"/>Hủy phần chưa thực hiện/đóng thiếu<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>document.read [WAREHOUSE]<BR ALIGN="LEFT"/>Xem chứng từ<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>issue.post [WAREHOUSE]<BR ALIGN="LEFT"/>Xác nhận xuất hàng<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>lot.correct [WAREHOUSE]<BR ALIGN="LEFT"/>Sửa dữ liệu lô đã có phát sinh<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>master.read [GLOBAL]<BR ALIGN="LEFT"/>Xem sản phẩm, UOM, barcode, nhóm<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>move.post [WAREHOUSE]<BR ALIGN="LEFT"/>Ghi sổ chuyển vị trí/cất hàng<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>ownership.read [WAREHOUSE]<BR ALIGN="LEFT"/>Đọc phân tách tồn theo chủ sở hữu<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"group2" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>Quyền 15–21</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">partner.read [GLOBAL]<BR ALIGN="LEFT"/>Xem đối tác<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>pick.confirm [WAREHOUSE]<BR ALIGN="LEFT"/>Xác nhận soạn/đóng gói<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>print.execute [WAREHOUSE]<BR ALIGN="LEFT"/>In/in lại phiếu hoặc tem<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>quality.decide [WAREHOUSE]<BR ALIGN="LEFT"/>Kiểm tra hàng và quyết định chất lượng<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>receipt.post [WAREHOUSE]<BR ALIGN="LEFT"/>Ghi nhận hàng thực nhận<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>report.read [WAREHOUSE]<BR ALIGN="LEFT"/>Xem 8 báo cáo định sẵn<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>reservation.manage [WAREHOUSE]<BR ALIGN="LEFT"/>Giữ/giải phóng hàng<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"group3" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>Quyền 22–28</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">return.post [WAREHOUSE]<BR ALIGN="LEFT"/>Ghi nhận khách trả/trả NCC<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>serial.read [WAREHOUSE]<BR ALIGN="LEFT"/>Tra serial và nguồn bảo hành<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>stock.read [WAREHOUSE]<BR ALIGN="LEFT"/>Xem tồn và thẻ kho<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>transfer.dispatch [WAREHOUSE]<BR ALIGN="LEFT"/>Xuất chuyển từ kho nguồn<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>transfer.draft [WAREHOUSE]<BR ALIGN="LEFT"/>Lập/sửa/gửi duyệt Lệnh chuyển<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>transfer.receive [WAREHOUSE]<BR ALIGN="LEFT"/>Nhận chuyển tại kho đích<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>warranty.write [WAREHOUSE]<BR ALIGN="LEFT"/>Ghi bổ sung chứng cứ bảo hành<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"role" -> "group0" [label=""];
"role" -> "group1" [label=""];
"role" -> "group2" [label=""];
"role" -> "group3" [label=""];
}