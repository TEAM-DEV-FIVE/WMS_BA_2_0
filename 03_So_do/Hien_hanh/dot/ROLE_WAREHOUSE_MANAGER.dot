digraph WMS {
graph [rankdir=TB, bgcolor="white", nodesep=.32, ranksep=.6, pad=.28];
node [shape=plain, fontname="DejaVu Sans", fontsize=12];
edge [fontname="DejaVu Sans", fontsize=10, color="#567086", fontcolor="#334155", arrowsize=.7];
label="Vai trò và quyền seed · Quản lý kho"; labelloc=t; fontname="DejaVu Sans"; fontsize=20;
"role" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>Quản lý kho</B></FONT></TD></TR><TR><TD ALIGN="LEFT">WAREHOUSE_MANAGER</TD></TR></TABLE>>];
"group0" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>Quyền 1–7</B></FONT></TD></TR><TR><TD ALIGN="LEFT">adjustment.draft [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Lập/sửa/gửi duyệt Điều chỉnh</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">count.create [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Tạo phiên và khóa vị trí kiểm kê</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">count.enter [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Nhập số đếm/đếm lại</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">count.snapshot.read [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Xem số hệ thống và chênh lệch</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">count.submit [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Chọn kết quả và trình điều chỉnh</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">document.approve [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Duyệt phiếu thông thường</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">document.assign [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Phân công phiếu</TD></TR><TR><TD ALIGN="LEFT"></TD></TR></TABLE>>];
"group1" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>Quyền 8–14</B></FONT></TD></TR><TR><TD ALIGN="LEFT">document.cancel [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Hủy phần chưa thực hiện/đóng thiếu</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">document.read [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Xem chứng từ</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">issue.post [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Xác nhận xuất hàng</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">lot.correct [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Sửa dữ liệu lô đã có phát sinh</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">master.read [GLOBAL]</TD></TR><TR><TD ALIGN="LEFT">Xem sản phẩm, UOM, barcode, nhóm</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">move.post [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Ghi sổ chuyển vị trí/cất hàng</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">ownership.read [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Đọc phân tách tồn theo chủ sở hữu</TD></TR><TR><TD ALIGN="LEFT"></TD></TR></TABLE>>];
"group2" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>Quyền 15–21</B></FONT></TD></TR><TR><TD ALIGN="LEFT">partner.read [GLOBAL]</TD></TR><TR><TD ALIGN="LEFT">Xem đối tác</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">pick.confirm [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Xác nhận soạn/đóng gói</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">print.execute [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">In/in lại phiếu hoặc tem</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">quality.decide [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Kiểm tra hàng và quyết định chất lượng</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">receipt.post [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Ghi nhận hàng thực nhận</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">report.read [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Xem 8 báo cáo định sẵn</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">reservation.manage [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Giữ/giải phóng hàng</TD></TR><TR><TD ALIGN="LEFT"></TD></TR></TABLE>>];
"group3" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>Quyền 22–28</B></FONT></TD></TR><TR><TD ALIGN="LEFT">return.post [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Ghi nhận khách trả/trả NCC</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">serial.read [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Tra serial và nguồn bảo hành</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">stock.read [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Xem tồn và thẻ kho</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">transfer.dispatch [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Xuất chuyển từ kho nguồn</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">transfer.draft [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Lập/sửa/gửi duyệt Lệnh chuyển</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">transfer.receive [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Nhận chuyển tại kho đích</TD></TR><TR><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">warranty.write [WAREHOUSE]</TD></TR><TR><TD ALIGN="LEFT">Ghi bổ sung chứng cứ bảo hành</TD></TR><TR><TD ALIGN="LEFT"></TD></TR></TABLE>>];
"role" -> "group0" [label=""];
"role" -> "group1" [label=""];
"role" -> "group2" [label=""];
"role" -> "group3" [label=""];
}