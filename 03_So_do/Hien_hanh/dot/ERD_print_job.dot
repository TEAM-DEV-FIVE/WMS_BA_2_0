digraph WMS {
graph [rankdir=LR, bgcolor="white", nodesep=.32, ranksep=.6, pad=.28];
node [shape=plain, fontname="DejaVu Sans", fontsize=12];
edge [fontname="DejaVu Sans", fontsize=10, color="#567086", fontcolor="#334155", arrowsize=.7];
label="ERD hiện hành · print_job"; labelloc=t; fontname="DejaVu Sans"; fontsize=20;
"print_job" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>print_job</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id : uuid</TD></TR><TR><TD ALIGN="LEFT">requested_by : uuid</TD></TR><TR><TD ALIGN="LEFT">session_id : uuid</TD></TR><TR><TD ALIGN="LEFT">warehouse_id : uuid</TD></TR><TR><TD ALIGN="LEFT">source_id : uuid</TD></TR><TR><TD ALIGN="LEFT">source_version : integer</TD></TR><TR><TD ALIGN="LEFT">template : character varying(20)</TD></TR><TR><TD ALIGN="LEFT">template_version : integer</TD></TR><TR><TD ALIGN="LEFT">paper : character varying(10)</TD></TR><TR><TD ALIGN="LEFT">include_price : boolean</TD></TR><TR><TD ALIGN="LEFT">criteria : jsonb</TD></TR><TR><TD ALIGN="LEFT">snapshot : jsonb</TD></TR><TR><TD ALIGN="LEFT">snapshot_hash : character(64)</TD></TR><TR><TD ALIGN="LEFT">status : character varying(12)</TD></TR><TR><TD ALIGN="LEFT">version : integer</TD></TR><TR><TD ALIGN="LEFT">generation : integer</TD></TR><TR><TD ALIGN="LEFT">file_id : uuid ?</TD></TR><TR><TD ALIGN="LEFT">created_at : timestamp with time zone</TD></TR><TR><TD ALIGN="LEFT">expires_at : timestamp with time zone</TD></TR><TR><TD ALIGN="LEFT">error_code : character varying(40) ?</TD></TR></TABLE>>];
"stored_file" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>stored_file</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Bảng đích — các cột được tham chiếu</TD></TR><TR><TD ALIGN="LEFT">id : uuid</TD></TR></TABLE>>];
"app_user" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>app_user</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Bảng đích — các cột được tham chiếu</TD></TR><TR><TD ALIGN="LEFT">id : uuid</TD></TR></TABLE>>];
"auth_session" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>auth_session</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Bảng đích — các cột được tham chiếu</TD></TR><TR><TD ALIGN="LEFT">id : uuid</TD></TR></TABLE>>];
"warehouse" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>warehouse</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Bảng đích — các cột được tham chiếu</TD></TR><TR><TD ALIGN="LEFT">id : uuid</TD></TR></TABLE>>];
"print_job" -> "stored_file" [label="file_id → id"];
"print_job" -> "app_user" [label="requested_by → id"];
"print_job" -> "auth_session" [label="session_id → id"];
"print_job" -> "warehouse" [label="warehouse_id → id"];
}