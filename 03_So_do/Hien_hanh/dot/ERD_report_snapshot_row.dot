digraph WMS {
graph [rankdir=LR, bgcolor="white", nodesep=.32, ranksep=.6, pad=.28];
node [shape=plain, fontname="DejaVu Sans", fontsize=12];
edge [fontname="DejaVu Sans", fontsize=10, color="#567086", fontcolor="#334155", arrowsize=.7];
label="ERD hiện hành · report_snapshot_row"; labelloc=t; fontname="DejaVu Sans"; fontsize=20;
"report_snapshot_row" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>report_snapshot_row</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK snapshot_id : uuid</TD></TR><TR><TD ALIGN="LEFT">PK ordinal : integer</TD></TR><TR><TD ALIGN="LEFT">payload : jsonb</TD></TR></TABLE>>];
"report_snapshot" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>report_snapshot</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Bảng đích — các cột được tham chiếu</TD></TR><TR><TD ALIGN="LEFT">id : uuid</TD></TR></TABLE>>];
"report_snapshot_row" -> "report_snapshot" [label="snapshot_id → id"];
}