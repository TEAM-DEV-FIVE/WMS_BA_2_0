digraph WMS {
graph [rankdir=LR, bgcolor="white", nodesep=.5, ranksep=.9, pad=.3];
node [shape=plain, fontname="DejaVu Sans", fontsize=12];
edge [fontname="DejaVu Sans", fontsize=10, color="#334155", fontcolor="#334155", arrowsize=.8];
label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="3"><TR><TD><FONT POINT-SIZE="20">Kiến trúc ứng dụng hiện tại</FONT></TD></TR><TR><TD><FONT POINT-SIZE="10">Kiến trúc triển khai · Desktop, API, lưu trữ và worker</FONT></TD></TR></TABLE>>; labelloc=t; fontname="DejaVu Sans"; fontsize=16;
"desktop" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>Desktop Tkinter</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">views / presenters / API client<BR ALIGN="LEFT"/>Luồng UI và executor I/O</TD></TR></TABLE>>];
"local" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>SQLite cục bộ</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Nháp và nhật ký lệnh<BR ALIGN="LEFT"/>Tách máy chủ / tài khoản / thiết bị</TD></TR></TABLE>>];
"proxy" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>Reverse proxy Nginx</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Cấu hình triển khai LAN<BR ALIGN="LEFT"/>HTTPS; chuyển header phục hồi</TD></TR></TABLE>>];
"api" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>FastAPI</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">create_app()<BR ALIGN="LEFT"/>Xác thực và dịch vụ nghiệp vụ</TD></TR></TABLE>>];
"db" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>PostgreSQL</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Schema wms<BR ALIGN="LEFT"/>108 bảng qua migration 001–026</TD></TR></TABLE>>];
"workers" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>Worker nền</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Outbox · import · export · print<BR ALIGN="LEFT"/>Export cleanup · print cleanup<BR ALIGN="LEFT"/>Auth delivery</TD></TR></TABLE>>];
"files" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>Kho tệp riêng</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Import / export / PDF<BR ALIGN="LEFT"/>Truy cập qua API kiểm quyền</TD></TR></TABLE>>];
"vault" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>Kho bí mật hệ điều hành</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">SessionVault<BR ALIGN="LEFT"/>Nhớ phiên khi người dùng bật</TD></TR></TABLE>>];
"print" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#526f83"><TR><TD BGCOLOR="#b7dff2"><B>Hệ thống in của máy</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">Spooler Windows / CUPS<BR ALIGN="LEFT"/>Máy quét HID nhập bàn phím</TD></TR></TABLE>>];
"desktop" -> "proxy" [label="HTTPS"];
"proxy" -> "api" [label="HTTP nội bộ"];
"api" -> "db" [label="SQLAlchemy / psycopg"];
"desktop" -> "local" [label="Nháp / key"];
"desktop" -> "vault" [label="Refresh token"];
"workers" -> "db" [label="Job / lease / ACK"];
"workers" -> "files" [label="Tác vụ tệp"];
"api" -> "files" [label="Kiểm soát tải tệp"];
"desktop" -> "print" [label="In / nhập mã"];
}