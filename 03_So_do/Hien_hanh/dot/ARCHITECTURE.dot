digraph WMS {
graph [rankdir=LR, bgcolor="white", nodesep=.32, ranksep=.6, pad=.28];
node [shape=plain, fontname="DejaVu Sans", fontsize=12];
edge [fontname="DejaVu Sans", fontsize=10, color="#567086", fontcolor="#334155", arrowsize=.7];
label="Kiến trúc ứng dụng hiện tại"; labelloc=t; fontname="DejaVu Sans"; fontsize=20;
"desktop" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>Desktop Tkinter</B></FONT></TD></TR><TR><TD ALIGN="LEFT">views / presenters / API client</TD></TR><TR><TD ALIGN="LEFT">Luồng UI và executor I/O</TD></TR></TABLE>>];
"local" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>SQLite cục bộ</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Nháp và nhật ký lệnh</TD></TR><TR><TD ALIGN="LEFT">Tách máy chủ / tài khoản / thiết bị</TD></TR></TABLE>>];
"proxy" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>Reverse proxy Nginx</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Cấu hình triển khai LAN</TD></TR><TR><TD ALIGN="LEFT">HTTPS; chuyển header phục hồi</TD></TR></TABLE>>];
"api" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>FastAPI</B></FONT></TD></TR><TR><TD ALIGN="LEFT">create_app()</TD></TR><TR><TD ALIGN="LEFT">Xác thực và dịch vụ nghiệp vụ</TD></TR></TABLE>>];
"db" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>PostgreSQL</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Schema wms</TD></TR><TR><TD ALIGN="LEFT">108 bảng qua migration 001–026</TD></TR></TABLE>>];
"workers" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>Worker nền</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Outbox · import · export · print</TD></TR><TR><TD ALIGN="LEFT">Export cleanup · print cleanup</TD></TR><TR><TD ALIGN="LEFT">Auth delivery</TD></TR></TABLE>>];
"files" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>Kho tệp riêng</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Import / export / PDF</TD></TR><TR><TD ALIGN="LEFT">Truy cập qua API kiểm quyền</TD></TR></TABLE>>];
"vault" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>Kho bí mật hệ điều hành</B></FONT></TD></TR><TR><TD ALIGN="LEFT">SessionVault</TD></TR><TR><TD ALIGN="LEFT">Nhớ phiên khi người dùng bật</TD></TR></TABLE>>];
"print" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>Hệ thống in của máy</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Spooler Windows / CUPS</TD></TR><TR><TD ALIGN="LEFT">Máy quét HID nhập bàn phím</TD></TR></TABLE>>];
"desktop" -> "proxy" [label="HTTPS"];
"proxy" -> "api" [label="HTTP nội bộ"];
"api" -> "db" [label="SQLAlchemy / psycopg"];
"desktop" -> "local" [label="Nháp / key"];
"desktop" -> "vault" [label="Refresh token"];
"workers" -> "db" [label="Job / lease / ACK"];
"workers" -> "files" [label="Tác vụ tệp"];
"api" -> "files" [label="Kiểm soát tải tệp"];
"desktop" -> "print" [label="In / nhập mã"];
}