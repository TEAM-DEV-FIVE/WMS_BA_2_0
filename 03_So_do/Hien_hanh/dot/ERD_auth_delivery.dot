digraph WMS {
graph [rankdir=LR, bgcolor="white", nodesep=.32, ranksep=.6, pad=.28];
node [shape=plain, fontname="DejaVu Sans", fontsize=12];
edge [fontname="DejaVu Sans", fontsize=10, color="#567086", fontcolor="#334155", arrowsize=.7];
label="ERD hiện hành · auth_delivery"; labelloc=t; fontname="DejaVu Sans"; fontsize=20;
"auth_delivery" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>auth_delivery</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id : uuid</TD></TR><TR><TD ALIGN="LEFT">user_id : uuid</TD></TR><TR><TD ALIGN="LEFT">auth_version : integer</TD></TR><TR><TD ALIGN="LEFT">ciphertext : text ?</TD></TR><TR><TD ALIGN="LEFT">expires_at : timestamp with time zone</TD></TR><TR><TD ALIGN="LEFT">attempts : integer</TD></TR><TR><TD ALIGN="LEFT">lease_until : timestamp with time zone ?</TD></TR><TR><TD ALIGN="LEFT">lease_token : uuid ?</TD></TR><TR><TD ALIGN="LEFT">completed_at : timestamp with time zone ?</TD></TR><TR><TD ALIGN="LEFT">last_error : text ?</TD></TR></TABLE>>];
"app_user" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#b7c9da"><TR><TD BGCOLOR="#005b9e"><FONT COLOR="white"><B>app_user</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Bảng đích — các cột được tham chiếu</TD></TR><TR><TD ALIGN="LEFT">id : uuid</TD></TR></TABLE>>];
"auth_delivery" -> "app_user" [label="user_id → id"];
}