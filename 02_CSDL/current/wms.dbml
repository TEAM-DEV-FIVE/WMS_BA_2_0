  product_id uuid [not null]
  effective_on date [not null]
  amount numeric(20,4) [not null]
  currency character(3) [not null]
  source text [not null]
  created_by uuid [not null]
}

Table wms.report_request_guard {
  user_id uuid [not null, pk]
  version bigint [not null]
}

Table wms.report_snapshot {
  id uuid [not null, pk]
  requested_by uuid [not null]
  report_code "character varying(3)" [not null]
  criteria jsonb [not null]
  required_warehouses uuid[] [not null]
  created_at "timestamp with time zone" [not null]
  expires_at "timestamp with time zone" [not null]
  row_count integer [not null]
  columns jsonb [not null]
  sha256 character(64) [not null]
}

Table wms.report_snapshot_row {
  snapshot_id uuid [not null]
  ordinal integer [not null]
  payload jsonb [not null]
  indexes {
    (snapshot_id, ordinal) [pk]
  }
}

Table wms.reservation {
  id uuid [not null, pk]
  line_id uuid [not null]
  stock_item_id uuid [not null]
  location_id uuid [not null]
  quantity numeric(20,6) [not null]
  consumed numeric(20,6) [not null]
  released numeric(20,6) [not null]
  expires_at "timestamp with time zone"
  created_by uuid [not null]
}

Table wms.reservation_consumption {
  id uuid [not null, pk]
  reservation_id uuid [not null]
  move_id uuid [not null]
  quantity numeric(20,6) [not null]
}

Table wms.return_document {
  document_id uuid [not null, pk]
  source_document_id uuid [not null]
}

Table wms.return_line {
  document_line_id uuid [not null, pk]
  source_move_id uuid [not null]
  location_id uuid [not null]
}

Table wms.reversal_document {
  document_id uuid [not null, pk]
  source_transaction_id uuid [not null]
  source_version integer [not null]
  reversal_reason text [not null]
}

Table wms.reversal_line {
  document_line_id uuid [not null, pk]
  source_move_id uuid [not null]
}

Table wms.role {
  id uuid [not null, pk]
  code "character varying(60)" [not null]
  name "character varying(160)" [not null]
  is_active boolean [not null]
}

Table wms.role_permission {
  id uuid [not null, pk]
  role_id uuid [not null]
  permission_id uuid [not null]
}

Table wms.serial {
  id uuid [not null, pk]
  product_id uuid [not null]
  code "character varying(160)" [not null]
  warranty_version integer [not null]
}

Table wms.serial_position {
  id uuid [not null, pk]
  serial_id uuid [not null]
  location_id uuid [not null]
  last_move_id uuid [not null]
}

Table wms.serial_warranty_record {
  id uuid [not null, pk]
  serial_id uuid [not null]
  receipt_move_id uuid [not null]
  revision integer [not null]
  starts_on date
  ends_on date
  evidence_ref text
  recorded_by uuid [not null]
  recorded_at "timestamp with time zone" [not null]
  reason text [not null]
}

Table wms.stock_balance {
  id uuid [not null, pk]
  stock_item_id uuid [not null]
  location_id uuid [not null]
  on_hand numeric(20,6) [not null]
  reserved numeric(20,6) [not null]
  version bigint [not null]
}

Table wms.stock_item {
  id uuid [not null, pk]
  product_id uuid [not null]
  lot_id uuid
  serial_id uuid
  owner_id uuid [not null]
  consignment_id uuid
}

Table wms.stock_move {
  id uuid [not null, pk]
  transaction_id uuid [not null]
  line_id uuid [not null]
  stock_item_id uuid [not null]
  source_location_id uuid [not null]
  destination_location_id uuid [not null]
  quantity_base numeric(20,6) [not null]
  base_uom_id uuid [not null]
  reverses_move_id uuid
}

Table wms.stock_owner {
  id uuid [not null, pk]
  code "character varying(80)" [not null]
  name "character varying(240)" [not null]
  kind "character varying(20)" [not null]
  partner_id uuid
  is_active boolean [not null]
  version integer [not null]
}

Table wms.stock_period {
  id uuid [not null, pk]
  warehouse_id uuid [not null]
  starts_on date [not null]
  ends_on date [not null]
  status "character varying(10)" [not null]
  closed_by uuid
  closed_at "timestamp with time zone"
  version integer [not null]
}

Table wms.stored_file {
  id uuid [not null, pk]
  storage_key text [not null]
  original_name "character varying(240)" [not null]
  mime_type "character varying(100)" [not null]
  sha256 character(64) [not null]
  size_bytes bigint [not null]
  uploaded_by uuid [not null]
  created_at "timestamp with time zone" [not null]
}

Table wms.transfer_adjustment {
  document_id uuid [not null, pk]
  source_transfer_id uuid [not null]
  discrepancy_id uuid [not null]
}

Table wms.transfer_discrepancy {
  id uuid [not null, pk]
  transfer_document_id uuid [not null]
  dispatch_move_id uuid [not null]
  kind "character varying(20)" [not null]
  quantity numeric(20,6) [not null]
  evidence_ref "character varying(2000)" [not null]
  recorded_by uuid [not null]
  recorded_at "timestamp with time zone" [not null]
}

Table wms.transfer_line {
  document_line_id uuid [not null, pk]
  stock_item_id uuid [not null]
  source_location_id uuid [not null]
}

Table wms.transfer_move {
  move_id uuid [not null, pk]
  dispatch_move_id uuid
  disposition "character varying(20)" [not null]
  evidence_ref "character varying(2000)" [not null]
}

Table wms.uom {
  id uuid [not null, pk]
  code "character varying(30)" [not null]
  name "character varying(80)" [not null]
  decimal_places integer [not null]
  version integer [not null]
  is_active boolean [not null]
}

Table wms.user_avatar {
  user_id uuid [not null, pk]
  image_base64 text
  version integer [not null]
  updated_at "timestamp with time zone" [not null]
}

Table wms.user_role_grant {
  id uuid [not null, pk]
  user_id uuid [not null]
  role_id uuid [not null]
  scope_kind "character varying(20)" [not null]
  warehouse_id uuid
  valid_from "timestamp with time zone" [not null]
  valid_until "timestamp with time zone"
  granted_by uuid [not null]
  revoked_at "timestamp with time zone"
}

Table wms.warehouse {
  id uuid [not null, pk]
  code "character varying(40)" [not null]
  name "character varying(160)" [not null]
  address text
  is_active boolean [not null]
  version integer [not null]
}

Table wms.worker_status {
  id uuid [not null, pk]
  kind "character varying(20)" [not null]
  registry_hash character(64) [not null]
  state "character varying(10)" [not null]
  started_at "timestamp with time zone" [not null]
  heartbeat_at "timestamp with time zone" [not null]
  result_code "character varying(40)"
  completed_cycles bigint [not null]
}

