// Additive schema for development migration 011_b01_import_files.sql.
// import_job below lists only added columns; combine with baseline.
Table import_file {
  file_id uuid [pk, not null, ref: > stored_file.id]
  actor_id uuid [not null, ref: > app_user.id]
  warehouse_id uuid [ref: > warehouse.id]
  kind varchar(60) [not null]
  upload_key uuid [not null]
  request_hash char(64) [not null]
  ready boolean [not null]
  indexes {
    (actor_id, upload_key) [unique]
  }
}
Table import_task {
  id uuid [pk, not null]
  job_id uuid [not null, ref: > import_job.id]
  generation integer [not null]
  state varchar(20) [not null]
  lease_token uuid
  lease_until timestamptz
  attempts integer [not null]
  available_at timestamptz [not null]
  last_error varchar(60)
  indexes {
    (job_id, generation) [unique]
  }
}
Table import_document_source {
  warehouse_id uuid [not null, ref: > warehouse.id]
  kind varchar(20) [not null]
  source_key varchar(240) [not null]
  document_id uuid [not null, ref: > document.id]
  job_id uuid [not null, ref: > import_job.id]
  indexes {
    (warehouse_id, kind, source_key) [pk]
    document_id [unique]
  }
}
Table import_job {
  warehouse_id uuid [ref: > warehouse.id]
  version integer [not null]
  generation integer [not null]
  auth_version integer
  options jsonb [not null]
  commit_token uuid
  token_expires_at timestamptz
  stage_hash char(64)
  data_snapshot jsonb [not null]
  total_rows integer [not null]
  processed_rows integer [not null]
  errors jsonb [not null]
  result jsonb
}
