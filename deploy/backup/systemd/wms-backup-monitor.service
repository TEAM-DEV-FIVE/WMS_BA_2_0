[Unit]
Description=Verify latest WMS recovery checkpoint, archive status and repository capacity
After=postgresql@16-main.service
RequiresMountsFor=/mnt/wms-backup

[Service]
Type=oneshot
User=root
UMask=0077
LimitCORE=0
ExecStart=/usr/bin/python3 -I /opt/wms/backup/backup_admin.py monitor
TimeoutStartSec=10min
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/mnt/wms-backup
StandardOutput=journal
StandardError=journal
