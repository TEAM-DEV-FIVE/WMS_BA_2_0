# Copy to a private mode-0600 environment file and replace placeholders.
# The desktop uses the API URL, never database credentials.
WMS_DATABASE_URL=mysql+pymysql://APP_USER:URL_ENCODED_PASSWORD@localhost/wms_mysql?unix_socket=/var/run/mysqld/mysqld.sock&charset=utf8mb4
WMS_HOST=127.0.0.1
WMS_PORT=8000
WMS_BUSINESS_TIMEZONE=Asia/Ho_Chi_Minh
