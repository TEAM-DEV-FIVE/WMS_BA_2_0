# Literal KEY=value, no quotes, export or interpolation. root:root 0644.
WMS_DATABASE_URL=postgresql+psycopg://wms_app@/wms?host=/var/run/postgresql
WMS_HOST=127.0.0.1
WMS_PORT=8000
WMS_POOL_SIZE=3
WMS_DATABASE_TIMEOUT_SECONDS=30
WMS_BUSINESS_TIMEZONE=Asia/Ho_Chi_Minh
WMS_IMPORT_STORAGE_ROOT=/srv/wms/import
WMS_EXPORT_STORAGE_ROOT=/srv/wms/export
WMS_PRINT_STORAGE_ROOT=/srv/wms/print
WMS_OUTBOX_CONSUMER_FACTORY=apps.server.consumers.registry:consumer_factory
WMS_OUTBOX_MAX_ATTEMPTS=5
WMS_OUTBOX_BATCH_SIZE=100
WMS_OUTBOX_POLL_SECONDS=1
WMS_OUTBOX_BACKOFF_BASE_SECONDS=5
WMS_OUTBOX_BACKOFF_MAX_SECONDS=300
WMS_IMPORT_LEASE_SECONDS=300
WMS_EXPORT_LEASE_SECONDS=300
WMS_PRINT_LEASE_SECONDS=300
WMS_IMPORT_MAX_ATTEMPTS=5
WMS_EXPORT_MAX_ATTEMPTS=5
WMS_PRINT_MAX_ATTEMPTS=5
