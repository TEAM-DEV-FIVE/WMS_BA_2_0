[Unit]
Description=WMS worker %i
Requires=postgresql@16-main.service
After=postgresql@16-main.service
PartOf=wms.target
RequiresMountsFor=/srv/wms /var/lib/postgresql
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=wms
Group=wms
WorkingDirectory=/opt/wms/current
LoadCredential=mfa.env:/etc/wms/mfa.env
ExecStart=/opt/wms/current/venv/bin/python -I /opt/wms/current/lan_runtime.py worker --kind %i
Restart=on-failure
RestartSec=10
TimeoutStopSec=360
KillSignal=SIGTERM
KillMode=control-group
UMask=0077
LimitCORE=0
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
ReadWritePaths=/srv/wms/import /srv/wms/export /srv/wms/print
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wms-worker-%i

[Install]
WantedBy=wms.target
